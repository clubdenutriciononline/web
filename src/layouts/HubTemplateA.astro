---
// Variante A de hub: SOLO Hormonas. Grid final de 4 tarjetas (elección
// editorial entre sus 6 subpáginas reales).
// Hormonas es también la única página madre con el hero "side" (imagen a
// la derecha, texto a la izquierda) — las otras 4 usan "overlay" (imagen
// a ancho completo con tarjeta de texto superpuesta), que es el valor
// por defecto de Hero.astro.
// Ver 00-analisis/02-mapa-migracion.md sección 2 y 04-revision-estructural.md.
import BaseLayout from './BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TemasRelacionadosGrid from '../components/TemasRelacionadosGrid.astro';
import ArticulosRelacionados from '../components/ArticulosRelacionados.astro';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';

interface Tema {
  icon: string | ImageMetadata;
  title: string;
  text: string;
  href: string;
}

interface Props {
  seoTitle: string;
  seoDescription: string;
  heroTitle: string;
  heroSubtitle?: string;
  heroCtaIntro?: string;
  heroImage?: ImageMetadata;
  heroImageAlt?: string;
  ctaLabel: string;
  ctaHref: string;
  temasHeading: string;
  temas: Tema[]; // 4 tarjetas en Hormonas
  articulosRelacionados: CollectionEntry<'blog' | 'radar'>[];
}

const {
  seoTitle,
  seoDescription,
  heroTitle,
  heroSubtitle,
  heroCtaIntro,
  heroImage,
  heroImageAlt,
  ctaLabel,
  ctaHref,
  temasHeading,
  temas,
  articulosRelacionados,
} = Astro.props;
---

<BaseLayout title={seoTitle} description={seoDescription}>
<div class="hub">
  <Hero
    title={heroTitle}
    subtitle={heroSubtitle}
    ctaIntro={heroCtaIntro}
    ctaLabel={ctaLabel}
    ctaHref={ctaHref}
    image={heroImage}
    imageAlt={heroImageAlt}
    layout="side"
  />

  <slot />

  <TemasRelacionadosGrid heading={temasHeading} temas={temas} />

  <ArticulosRelacionados articulos={articulosRelacionados} />

</div>
</BaseLayout>
