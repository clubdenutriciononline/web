---
// Plantilla de publicación de Radar de Salud — distinta del Blog: sin
// breadcrumb, sin imagen en el cuerpo, secciones fijas con emoji, nivel de
// evidencia, fuente en texto plano, y botones de compartir (ausentes en el
// Blog normal). Radar de Salud es un tipo de contenido independiente del
// Blog, con su propia collection (`radar`) y su propia plantilla.
import BaseLayout from './BaseLayout.astro';
import ShareButtons from '../components/ShareButtons.astro';
import ArticulosRelacionados from '../components/ArticulosRelacionados.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'radar'>;
  relacionados: CollectionEntry<'blog' | 'radar'>[];
}

const { entry, relacionados } = Astro.props;
const { title, description, seo, date, updated, nivelEvidencia, fuente } = entry.data;
const url = Astro.url.href;

// NewsArticle: el Radar de Salud es un boletín de noticias/novedades de
// investigación (no un artículo evergreen de blog), encaja mejor con este
// tipo que con Article genérico.
const newsArticleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  author: {
    '@type': 'Organization',
    name: 'Club de Nutrición',
  },
};
---

<BaseLayout title={seo?.title ?? title} description={seo?.description ?? description}>
  <script type="application/ld+json" set:html={JSON.stringify(newsArticleJsonLd)} is:inline />
  <article class="radar-post">
    <span class="etiqueta">Radar de Salud</span>
    <h1>{title}</h1>

    <div class="cuerpo">
      <!-- El cuerpo markdown contiene las secciones fijas:
           🔬 Qué ha pasado / 🧠 Por qué importa / 🩺 Interpretación clínica /
           ⚡ Conclusión rápida — se replican tal cual, en ese orden. -->
      <slot />
    </div>

    <p class="nivel-evidencia">🔎 Nivel de evidencia: {nivelEvidencia}</p>
    <p class="fuente">Fuente: {fuente}</p>
    <p class="fecha">Fecha: {date.toLocaleDateString('es-ES')}</p>

    <ShareButtons url={url} title={title} />
  </article>

  <ArticulosRelacionados articulos={relacionados} />
</BaseLayout>

<style>
  .etiqueta {
    display: inline-block;
    text-transform: uppercase;
    font-size: 0.75rem;
    color: var(--color-accent, #c2185b);
    margin-bottom: 0.5rem;
    background: var(--color-accent-soft);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
  }
  /* Aproximación al patrón real (cada sección — Qué ha pasado / Por qué
     importa / Interpretación clínica / Conclusión rápida — va en su propia
     caja lila redondeada en el original). El cuerpo viene de Markdown sin
     wrappers por sección, así que de momento se trata como un único panel
     continuo en vez de 4 cajas separadas — pendiente de un remark/rehype
     plugin para la réplica exacta. */
  .cuerpo {
    background: var(--color-surface-alt);
    border-radius: 1rem;
    padding: 1.5rem 2rem;
  }
  .cuerpo :global(h3) {
    color: var(--color-accent);
  }
  .cuerpo :global(h3:not(:first-child)) {
    margin-top: 2rem;
  }
</style>
