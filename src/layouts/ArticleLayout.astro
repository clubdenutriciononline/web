---
// Plantilla de artículo del blog. Rehecha el 18 oct con el formato de las
// páginas hijas (decisión de la usuaria, sobre la entrada de Fatiga crónica):
// - hero lateral de las hijas: título, frase (`lead`, el primer párrafo del
//   artículo), botón de la guía e imagen a la derecha;
// - miga de pan y fecha en una línea discreta, y tabla de contenidos (SEO)
//   sobre fondo blanco;
// - una sección por cada H2, alternando fondo degradado y blanco (las monta
//   src/lib/articulo-html.ts sobre el HTML de la entrada), con la tipografía
//   de las hijas;
// - preguntas frecuentes en desplegable y relacionados con las tarjetas de
//   las hijas, con paginación (Página X de Y) en vez de anterior/siguiente;
// - botones de compartir arriba y "Síguenos en redes" al final.
// Los enlaces externos se abren en pestaña nueva (articulo-html y BaseLayout).
// Radar de Salud usa RadarLayout.astro y las recetas RecipeLayout.astro.
import BaseLayout from './BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TableOfContents from '../components/TableOfContents.astro';
import RecipeNutritionTable from '../components/RecipeNutritionTable.astro';
import ArticulosRelacionados from '../components/ArticulosRelacionados.astro';
import ShareButtons from '../components/ShareButtons.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { socialLinks } from '../data/navigation';
import { MADRES, SUBS, MADRE_HREF } from '../lib/categorias';
import { estructurarArticulo } from '../lib/articulo-html';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';

interface Props {
  entry: CollectionEntry<'blog'>;
  categoria: string;
  headings: MarkdownHeading[];
  relacionados: CollectionEntry<'blog' | 'radar'>[];
}

const { entry, categoria, headings, relacionados } = Astro.props;
const urlPagina = new URL(Astro.url.pathname, Astro.site).href;
const { title, description, seo, image, imageAlt, date, updated, author, nutricion } = entry.data;

const { html: cuerpoHtml, lead } = estructurarArticulo(await Astro.slots.render('default'));

const [madreSlug, subSlug] = categoria.split('/');
const migas = [
  { label: 'Inicio', href: '/' },
  ...(MADRES[madreSlug] ? [{ label: MADRES[madreSlug], href: MADRE_HREF[madreSlug] }] : [{ label: 'Blog', href: '/blog/' }]),
  ...(subSlug && SUBS[subSlug] ? [{ label: SUBS[subSlug] }] : []),
];
const indice = headings.filter((h) => h.depth === 2).map((h) => ({ label: h.text.charAt(0).toLocaleUpperCase('es') + h.text.slice(1), anchor: h.slug }));

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: new URL(image.src, Astro.site).href,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  author: {
    '@type': 'Organization',
    name: author,
  },
};
---

<BaseLayout title={seo?.title ?? title} description={seo?.description ?? description} image={image.src}>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} is:inline />
  <div class="hub articulo">
    <Hero
      title={title}
      subtitle={lead ?? description}
      ctaIntro="Descubre cómo estabilizar tu energía, descarga la guía ahora:"
      ctaLabel="Descargar la guía ahora"
      ctaHref="/lm-5-pasos-optin/"
      image={image}
      imageAlt={imageAlt}
      layout="lateral"
      titleSize="hija"
    />

    <div class="art-meta">
      <Breadcrumb items={migas} />
      <!-- Sin fecha visible (decisión de la usuaria, 18 oct). Las fechas
           siguen en los datos estructurados (JSON-LD) para buscadores. -->
      <div class="compartir">
        <span>Compartir:</span>
        <ShareButtons url={urlPagina} title={title} />
      </div>
    </div>

    {indice.length > 1 && (
      <div class="art-indice">
        <TableOfContents heading="Tabla de contenidos" items={indice} />
      </div>
    )}

    <article class="cuerpo">
      <Fragment set:html={cuerpoHtml} />
      {nutricion && <RecipeNutritionTable nutricion={nutricion} />}
    </article>

    <section class="siguenos">
      <h2>Síguenos en redes</h2>
      <p>Más ideas sobre energía, hormonas y alimentación cada semana.</p>
      <div class="siguenos-iconos">
        {socialLinks.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
            <SocialIcon name={s.icon} />
          </a>
        ))}
      </div>
    </section>

    <ArticulosRelacionados articulos={relacionados} />
  </div>
</BaseLayout>

<style>
  /* Miga de pan y fecha: una línea discreta bajo el hero. */
  .art-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1.5rem;
    padding-top: 1.25rem;
    font-size: 14px;
    line-height: 1.5;
  }
  .art-indice {
    padding-block: 40px 57px;
  }

  /* Secciones por H2 (articulo-html): alternan degradado (band-b de las
     hijas) y blanco, empezando por degradado en la primera. */
  .cuerpo :global(.art-sec) {
    width: 100vw;
    position: relative;
    left: 50%;
    margin-left: -50vw;
  }
  .cuerpo :global(.art-sec:nth-of-type(odd)) {
    background: linear-gradient(180deg, #e89eff08 0%, #ecdbf1 100%);
  }
  .cuerpo :global(.art-sec-inner) {
    display: flow-root;
    max-width: var(--container-width);
    margin-inline: auto;
    padding: var(--space-section) var(--container-padding);
  }

  /* Tipografía de las hijas: H2 Rubik 600 32px ciruela centrado, subtítulo
     "destacado" Fredoka 24px/39px con 1.3px, texto Fredoka 20px/33px
     justificado, H3 Rubik 500 24px ciruela. */
  .cuerpo :global(h2) {
    color: #6c2f50;
    text-align: center;
  }
  .cuerpo :global(.art-subtitulo) {
    font-family: var(--font-body);
    font-size: 24px;
    line-height: 39px;
    letter-spacing: 1.3px;
    text-align: center;
    margin: 0 0 30px;
  }
  .cuerpo :global(p),
  .cuerpo :global(li) {
    font-family: var(--font-body);
    font-size: 20px;
    line-height: 33px;
    text-align: justify;
  }
  .cuerpo :global(h3) {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 500;
    line-height: 1.3;
    color: #6c2f50;
    margin: 1.75rem 0 0.75rem;
  }
  .cuerpo :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 1.5rem auto;
    border-radius: 20px;
    box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);
  }

  /* Imagen vertical flotando a la derecha, con el texto alrededor. */
  .cuerpo :global(.art-img-flotante) {
    float: right;
    width: calc(45% - 1rem);
    margin: 0 0 1.5rem 2rem;
  }
  .cuerpo :global(.art-img-flotante img) {
    margin: 0;
    width: 100%;
  }
  .art-meta :global(a),
  .cuerpo :global(a) {
    color: #6c2f50;
  }

  /* Soluciones en tarjetas con icono: mismo estilo que las tarjetas de
     soluciones de las hijas (SolucionesList variant="card"). 3 por fila y
     la última fila centrada; con 4, 2 + 2. */
  .cuerpo :global(.art-tarjetas) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 30px;
  }
  .cuerpo :global(.art-tarjeta) {
    flex: 0 1 calc((100% - 3rem) / 3);
    background: linear-gradient(150deg, #fdf2f7 0%, #f3e8f0 100%);
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
    border-radius: 10px;
    padding: 20px;
    text-align: center;
    transition: border-radius 0.3s, box-shadow 0.3s;
  }
  .cuerpo :global(.art-tarjetas[data-count='4'] .art-tarjeta),
  .cuerpo :global(.art-tarjetas[data-count='2'] .art-tarjeta) {
    flex-basis: calc((100% - 1.5rem) / 2);
  }
  /* Como en las hijas: 5 = 3 + 2 anchas; 7 = 2 anchas + 3 + 2 anchas. */
  .cuerpo :global(.art-tarjetas[data-count='5'] .art-tarjeta:nth-child(n + 4)),
  .cuerpo :global(.art-tarjetas[data-count='7'] .art-tarjeta:nth-child(-n + 2)),
  .cuerpo :global(.art-tarjetas[data-count='7'] .art-tarjeta:nth-child(n + 6)) {
    flex-basis: calc((100% - 1.5rem) / 2);
  }
  .cuerpo :global(.art-tarjeta:hover) {
    border-radius: 20px;
    box-shadow: 10px 10px 10px rgba(0, 0, 0, 0.5);
  }
  .cuerpo :global(.art-icono) {
    display: flex;
    justify-content: center;
    margin-bottom: 0.5rem;
    color: var(--color-accent, #c2185b);
  }
  .cuerpo :global(.art-icono svg) {
    width: 50px;
    height: 50px;
  }
  .cuerpo :global(.art-tarjeta h3) {
    margin: 0 0 20px;
  }
  .cuerpo :global(.art-tarjeta p) {
    text-align: center;
    margin-bottom: 1em;
  }
  .cuerpo :global(.art-tarjeta p:last-child) {
    margin-bottom: 0;
  }

  /* "Qué vas a aprender": recuadro blanco como el de la checklist. */
  .cuerpo :global(.art-caja) {
    background: #fff;
    border-radius: 20px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
    padding: 30px 40px 5px;
  }

  /* Preguntas frecuentes: desplegables, como en el original. */
  .cuerpo :global(.art-faq) {
    background: #fff;
    border-radius: 10px;
    box-shadow: 0 0 6px rgba(0, 0, 0, 0.15);
    margin-bottom: 12px;
    padding: 0 24px;
  }
  .cuerpo :global(.art-faq summary) {
    cursor: pointer;
    list-style: none;
    position: relative;
    padding: 16px 32px 16px 0;
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 500;
    color: #6c2f50;
  }
  .cuerpo :global(.art-faq summary::-webkit-details-marker) {
    display: none;
  }
  .cuerpo :global(.art-faq summary::after) {
    content: '+';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    font-size: 26px;
    font-weight: 400;
  }
  .cuerpo :global(.art-faq[open] summary::after) {
    content: '–';
  }
  .cuerpo :global(.art-faq > p) {
    margin-bottom: 1em;
  }

  .compartir {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: #666;
  }
  .siguenos {
    padding-block: var(--space-section) 0;
    text-align: center;
  }
  .siguenos h2 {
    color: #6c2f50;
    text-align: center;
  }
  .siguenos p {
    font-family: var(--font-body);
    font-size: 22px;
    margin-bottom: 1.25rem;
  }
  .siguenos-iconos {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }
  .siguenos-iconos a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 999px;
    background: #6c2f50;
    color: #fff;
    transition: background 0.2s;
  }
  .siguenos-iconos a:hover {
    background: #f964c0;
  }
  .siguenos-iconos :global(svg) {
    width: 24px;
    height: 24px;
    fill: currentColor;
  }

  @media (max-width: 767px) {
    .cuerpo :global(.art-subtitulo) {
      font-size: 19px;
      line-height: 1.6;
      letter-spacing: 0.4px;
    }
    .cuerpo :global(p),
    .cuerpo :global(li) {
      font-size: 18px;
      line-height: 1.65;
      text-align: left;
    }
    .cuerpo :global(.art-caja) {
      padding: 20px 20px 1px;
    }
    .cuerpo :global(.art-tarjeta) {
      flex-basis: 100% !important;
    }
    .cuerpo :global(.art-img-flotante) {
      float: none;
      width: 100%;
      margin: 0 0 1.5rem;
    }
  }
</style>
