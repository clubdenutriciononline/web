---
// Variante B de hub: Energía, Metabolismo, Microbiota, Mentalidad. Grid
// final de 3 tarjetas (1:1 con sus 3 subpáginas reales) + sección de
// artículos relacionados que HubTemplateA (Hormonas) no tiene.
import BaseLayout from './BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TemasRelacionadosGrid from '../components/TemasRelacionadosGrid.astro';
import ArticulosRelacionados from '../components/ArticulosRelacionados.astro';
import CTAFinal from '../components/CTAFinal.astro';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';

interface Tema {
  icon: string | ImageMetadata;
  title: string;
  text: string;
  href: string;
}

interface Props {
  seoTitle: string;
  seoDescription: string;
  heroTitle: string;
  heroSubtitle?: string;
  heroImage?: ImageMetadata;
  heroImageAlt?: string;
  ctaLabel: string;
  ctaHref: string;
  temasHeading: string;
  temas: Tema[]; // 3 tarjetas, 1:1 con las subpáginas del hub
  articulosRelacionados: CollectionEntry<'blog' | 'radar'>[];
}

const {
  seoTitle,
  seoDescription,
  heroTitle,
  heroSubtitle,
  heroImage,
  heroImageAlt,
  ctaLabel,
  ctaHref,
  temasHeading,
  temas,
  articulosRelacionados,
} = Astro.props;
---

<BaseLayout title={seoTitle} description={seoDescription}>
  <Hero
    title={heroTitle}
    subtitle={heroSubtitle}
    ctaLabel={ctaLabel}
    ctaHref={ctaHref}
    image={heroImage}
    imageAlt={heroImageAlt}
  />

  <slot />

  <TemasRelacionadosGrid heading={temasHeading} temas={temas} />

  <ArticulosRelacionados articulos={articulosRelacionados} />

  <CTAFinal heading={heroSubtitle ?? heroTitle} ctaLabel={ctaLabel} ctaHref={ctaHref} />
</BaseLayout>
