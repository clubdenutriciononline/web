---
// Variante B de subpágina (12 de 18): Fatiga Crónica, Sueño, Rutinas
// Energéticas, Pérdida de Grasa Femenina, Resistencia a la Insulina, Ayuno
// Intermitente, Digestión, Inflamación Intestinal, Probióticos y
// Alimentación, Ansiedad por la Comida, Estrés y Hábitos, Relación con el
// Cuerpo. Mismo esqueleto que SubpageTemplateA pero SIN el grid final de
// áreas relacionadas (no existe en el original para estas 12 páginas).
import BaseLayout from './BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ArticulosRelacionados from '../components/ArticulosRelacionados.astro';
import TemasRelacionadosGrid from '../components/TemasRelacionadosGrid.astro';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  seoTitle: string;
  seoDescription: string;
  heroTitle: string;
  heroSubtitle?: string;
  heroTitleSize?: 'display' | 'frase' | 'frase-rubik' | 'frase-media' | 'frase-rubik-ligera' | 'frase-grande' | 'frase-amplia' | 'medida';
  // Con heroTitleSize="medida": tipografía medida en el original.
  // Nombre de la página dentro de la frase del hero (negrita y mayúsculas).
  heroTitleDestacado?: string | string[];
  heroTitleMedida?: { font: 'heading' | 'body'; size: number; weight: number; lineHeight: number; marginBottom?: number };
  heroCtaIntro?: string;
  heroImage?: ImageMetadata;
  heroImageAlt?: string;
  ctaLabel: string;
  ctaHref: string;
  articulosRelacionados: CollectionEntry<'blog' | 'radar'>[];
  // "Áreas clave relacionadas" (18 oct): entre Soluciones y Artículos
  // relacionados, sin enlace hasta que exista el artículo de cada área.
  areasHeading?: string;
  areas?: { icon: string | ImageMetadata; title: string; text: string; href?: string }[];
}

const {
  seoTitle,
  seoDescription,
  heroTitle,
  heroSubtitle,
  heroTitleSize,
  heroTitleMedida,
  heroTitleDestacado,
  heroCtaIntro = 'Descubre cómo estabilizar tu energía, descarga la guía ahora:',
  heroImage,
  heroImageAlt,
  ctaLabel,
  ctaHref,
  articulosRelacionados,
  areasHeading = 'Áreas clave relacionadas',
  areas,
} = Astro.props;
---

<BaseLayout title={seoTitle} description={seoDescription}>
<div class="hub">
  <Hero
    title={heroTitle}
    subtitle={heroSubtitle}
    ctaLabel={ctaLabel}
    ctaHref={ctaHref}
    image={heroImage}
    imageAlt={heroImageAlt}
    layout="lateral"
    titleSize={heroTitleSize}
    titleMedida={heroTitleMedida}
    titleDestacado={heroTitleDestacado}
    ctaIntro={heroCtaIntro}
  />

  <slot />

  <!--
    Corrección de contenido (decisión de la usuaria, 2026-09-12): si esta
    página no tiene artículos relacionados disponibles (caso real hoy en
    /resistencia-insulina/), ArticulosRelacionados no renderiza nada — nunca
    se muestra un bloque vacío.
  -->
  {areas && areas.length > 0 && (
    <div class="areas-clave">
      <TemasRelacionadosGrid heading={areasHeading} temas={areas} />
    </div>
  )}

  <ArticulosRelacionados articulos={articulosRelacionados} />

</div>
</BaseLayout>

<style>
  /* Separación tras la banda de Soluciones (igual que antes de las causas). */
  .areas-clave {
    padding-top: 57px;
  }
</style>
