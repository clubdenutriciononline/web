---
// /radar-de-salud/ = índice curado del Radar de Salud (collection `radar`,
// independiente del Blog). /radar-de-salud/2/ = paginación.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticulosRelacionados from '../../components/ArticulosRelacionados.astro';
import type { GetStaticPathsOptions } from 'astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = (await getCollection('radar'))
    .filter((p) => !p.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  // 9 por página (decisión de la usuaria, 18 oct): 3 filas completas de 3
  // tarjetas; con 10 la última fila quedaba con una sola y rompía el equilibrio.
  return paginate(posts, { pageSize: 9 });
}

const { page } = Astro.props;
---

<BaseLayout
  title="Radar de Salud — Club de Nutrición"
  description="Boletín científico sobre menopausia, hormonas, nutrición y salud femenina."
>
  <h1>Radar de Salud</h1>

  <ArticulosRelacionados heading={false} articulos={page.data} pageSize={false} />

  <nav class="paginacion" aria-label="Paginación del Radar de Salud">
    {page.url.prev
      ? <a href={page.url.prev}>« Anterior</a>
      : <span class="pag-disabled">« Anterior</span>}
    <span class="pag-info">Página {page.currentPage} de {page.lastPage}</span>
    {page.url.next
      ? <a href={page.url.next}>Siguiente »</a>
      : <span class="pag-disabled">Siguiente »</span>}
  </nav>
</BaseLayout>

<style>
  /* Mismo formato que la paginación cliente de ArticulosRelacionados
     (colores corporativos), unificado 2026-10-17. */
  .paginacion {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem 0;
    font-family: var(--font-body);
  }
  .paginacion a {
    color: #f964c0;
    font-weight: 600;
    text-decoration: none;
  }
  .paginacion .pag-info {
    color: #6c2f50;
    font-weight: 500;
  }
  .paginacion .pag-disabled {
    color: #bbb;
  }
</style>
