---
// /blog/ = página 1, /blog/2/ ... /blog/8/ = resto (patrón estándar de
// paginación de Astro con [...page], igual URL que el original).
// Revisión visual 2026-09-14: unificado con el mismo componente/formato de
// tarjeta que el resto del sitio (ArticulosRelacionados: 3 columnas,
// insignia abajo-derecha, colores e icono reales) — antes tenía su propia
// tarjeta distinta, sin insignia ni avatar y con otros colores.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticulosRelacionados from '../../components/ArticulosRelacionados.astro';
import type { GetStaticPathsOptions } from 'astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = (await getCollection('blog'))
    .filter((p) => !p.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return paginate(posts, { pageSize: 10 });
}

const { page } = Astro.props;
---

<BaseLayout title="Blog — Club de Nutrición" description="Artículos de nutrición hormonal y bienestar para mujeres +35.">
  <h1>Blog</h1>
  <h2>Entradas de blog</h2>

  <ArticulosRelacionados heading={false} articulos={page.data} />

  <nav class="paginacion" aria-label="Paginación del blog">
    {page.url.prev && <a href={page.url.prev}>« Anterior</a>}
    <span>Página {page.currentPage} de {page.lastPage}</span>
    {page.url.next && <a href={page.url.next}>Siguiente »</a>}
  </nav>
</BaseLayout>

<style>
  .paginacion {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    padding: 2rem 0;
  }
</style>
