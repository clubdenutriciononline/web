---
// /blog/ = página 1, /blog/2/ ... /blog/8/ = resto (patrón estándar de
// paginación de Astro con [...page], igual URL que el original).
// Revisión visual 2026-09-14: unificado con el mismo componente/formato de
// tarjeta que el resto del sitio (ArticulosRelacionados: 3 columnas,
// insignia abajo-derecha, colores e icono reales) — antes tenía su propia
// tarjeta distinta, sin insignia ni avatar y con otros colores.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticulosRelacionados from '../../components/ArticulosRelacionados.astro';
import type { GetStaticPathsOptions } from 'astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = (await getCollection('blog'))
    .filter((p) => !p.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  // 9 por página (decisión de la usuaria, 18 oct): 3 filas completas de 3
  // tarjetas; con 10 la última fila quedaba con una sola y rompía el equilibrio.
  return paginate(posts, { pageSize: 9 });
}

const { page } = Astro.props;
---

<BaseLayout title="Blog — Club de Nutrición" description="Artículos de nutrición hormonal y bienestar para mujeres +35.">
  <h1>Blog</h1>
  <h2>Entradas de blog</h2>

  <ArticulosRelacionados heading={false} articulos={page.data} pageSize={false} />

  <nav class="paginacion" aria-label="Paginación del blog">
    {page.url.prev
      ? <a href={page.url.prev}>« Anterior</a>
      : <span class="pag-disabled">« Anterior</span>}
    <span class="pag-info">Página {page.currentPage} de {page.lastPage}</span>
    {page.url.next
      ? <a href={page.url.next}>Siguiente »</a>
      : <span class="pag-disabled">Siguiente »</span>}
  </nav>
</BaseLayout>

<style>
  /* Mismo formato que la paginación cliente de ArticulosRelacionados
     (colores corporativos), unificado 2026-10-17. */
  .paginacion {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem 0;
    font-family: var(--font-body);
  }
  .paginacion a {
    color: #f964c0;
    font-weight: 600;
    text-decoration: none;
  }
  .paginacion .pag-info {
    color: #6c2f50;
    font-weight: 500;
  }
  .paginacion .pag-disabled {
    color: #bbb;
  }
</style>
