---
// Embudo de la guía "5 pasos" — 1/3: página de registro (18 oct, con el
// formato del resto de la web: hero lateral de las hijas y bandas). Textos
// del original. El formulario es el del proveedor configurado en
// src/data/formularios.ts (hoy Mailrelay, como en el original). Fuera de
// buscadores. Flujo: registro → /lm-5-pasos-gracias/ (o el aviso del
// proveedor) → correo de confirmación → /lm-5-pasos-descarga/.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ChecklistCard from '../../components/ChecklistCard.astro';
import FormularioSuscripcion from '../../components/FormularioSuscripcion.astro';
import mockupImg from './_images/mockup.jpg';
---

<BaseLayout
  title="Recupera tu energía y equilibra tus hormonas en 5 pasos - Club de Nutrición"
  description="Una guía práctica basada en ciencia para mujeres +35 que quieren dejar de sentirse cansadas, hinchadas y sin energía (sin dietas extremas)."
  noindex
>
  <div class="hub">
    <Hero
      title="Recupera tu energía y equilibra tus hormonas en 5 pasos"
      subtitle="Una guía práctica basada en ciencia para mujeres +35 que quieren dejar de sentirse cansadas, hinchadas y sin energía (sin dietas extremas)."
      ctaIntro="Es gratis: déjanos tu correo y te la enviamos."
      ctaLabel="Quiero mi guía gratis"
      ctaHref="#formulario"
      image={mockupImg}
      imageAlt="Guía 5 pasos en una tableta y un móvil"
      layout="lateral"
      titleSize="hija"
    />

    <section class="optin">
      <div class="optin-lista">
        <h2>En esta guía encontrarás</h2>
        <ChecklistCard
          columns={1}
          items={[
            'Los 5 pasos clave para recuperar tu energía',
            'Qué alimentos realmente ayudan a tu equilibrio hormonal',
            'Cómo reducir inflamación sin complicarte',
            'Qué está bloqueando tu energía sin que lo sepas',
            'Acciones simples para empezar desde hoy',
          ]}
        />
      </div>
      <div class="optin-form" id="formulario">
        <h2>Descárgala gratis</h2>
        <FormularioSuscripcion nombre="guia" titulo="Formulario para recibir la guía 5 pasos" />
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .optin {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: stretch;
    padding-block: var(--space-section);
  }
  /* Títulos centrados sobre su tarjeta (20 oct). */
  .optin h2 {
    color: #6c2f50;
    text-align: center;
  }
  /* Mismo margen a la derecha que a la izquierda (2rem + 30px de la lista):
     el texto baja un par de líneas y las dos tarjetas quedan parecidas. */
  .optin-lista :global(.checklist-card) {
    padding-right: calc(2rem + 30px);
  }
  .optin-form {
    scroll-margin-top: 140px;
  }
  /* Las dos tarjetas (lista y formulario) con la misma altura (20 oct). */
  .optin-lista,
  .optin-form {
    display: flex;
    flex-direction: column;
  }
  .optin-lista :global(.checklist-card),
  .optin-form :global(.form-suscripcion) {
    flex: 1;
  }
  .optin-form :global(.form-suscripcion) {
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin-top: 1rem;
  }
  @media (max-width: 767px) {
    .optin {
      grid-template-columns: 1fr;
    }
    .optin-lista :global(.checklist-card) {
      padding-right: 2rem;
    }
  }
</style>
