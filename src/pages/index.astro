---
// Home — contenido real migrado desde https://clubdenutricion.es/, ver
// .firecrawl/md/home.md. Nota de fidelidad (verificado contra el HTML real):
// las 4 tarjetas de "Un enfoque diferente" usan iconos Font Awesome 5 en el
// original (fas fa-brain, fas fa-weight, fas fa-heart) para la 1ª, 2ª y 4ª;
// la 3ª ("Equilibrio hormonal real") en el original solo lleva el emoji ⚖️
// literal, sin icon-box. Por decisión de la usuaria (revisión visual
// 2026-09-14), se sustituye ese emoji por el icono real fa-balance-scale
// para que las 4 tarjetas tengan el mismo tratamiento visual — excepción
// consciente a la réplica 1:1, no un error de fidelidad.
// Como son iconos de una fuente vectorial (no imágenes descargables), se
// reproduce el SVG oficial de cada icono inline en vez de cargar la
// librería completa de Font Awesome solo para 4 iconos.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ArticulosRelacionados from '../components/ArticulosRelacionados.astro';
import CTAFinal from '../components/CTAFinal.astro';
import { Image } from 'astro:assets';
import heroImg from './_images/mujer-optin.jpg';

// Nota (revisión visual 2026-09-14): los SVG inyectados con set:html no
// reciben el atributo de scoping de Astro, así que el CSS con selector
// `svg[data-astro-cid-...]` de abajo nunca los alcanzaba y el icono no
// llegaba a tener tamaño (invisible en el render real, solo se veía el
// emoji de la 3ª tarjeta). Se fija el tamaño directamente en el propio SVG.
const iconoBrain = '<svg width="32" height="32" viewBox="0 0 576 512" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M208 0c-29.9 0-54.7 20.5-61.8 48.2-.8 0-1.4-.2-2.2-.2-35.3 0-64 28.7-64 64 0 4.8.6 9.5 1.7 14C52.5 138 32 166.6 32 200c0 12.6 3.2 24.3 8.3 34.9C16.3 248.7 0 274.3 0 304c0 33.3 20.4 61.9 49.4 73.9-.9 4.6-1.4 9.3-1.4 14.1 0 39.8 32.2 72 72 72 4.1 0 8.1-.5 12-1.2 9.6 28.5 36.2 49.2 68 49.2 39.8 0 72-32.2 72-72V64c0-35.3-28.7-64-64-64zm368 304c0-29.7-16.3-55.3-40.3-69.1 5.2-10.6 8.3-22.3 8.3-34.9 0-33.4-20.5-62-49.7-74 1-4.5 1.7-9.2 1.7-14 0-35.3-28.7-64-64-64-.8 0-1.5.2-2.2.2C422.7 20.5 397.9 0 368 0c-35.3 0-64 28.6-64 64v376c0 39.8 32.2 72 72 72 31.8 0 58.4-20.7 68-49.2 3.9.7 7.9 1.2 12 1.2 39.8 0 72-32.2 72-72 0-4.8-.5-9.5-1.4-14.1 29-12 49.4-40.6 49.4-73.9z"/></svg>';
const iconoWeight = '<svg width="32" height="32" viewBox="0 0 512 512" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M448 64h-25.98C438.44 92.28 448 125.01 448 160c0 105.87-86.13 192-192 192S64 265.87 64 160c0-34.99 9.56-67.72 25.98-96H64C28.71 64 0 92.71 0 128v320c0 35.29 28.71 64 64 64h384c35.29 0 64-28.71 64-64V128c0-35.29-28.71-64-64-64zM256 320c88.37 0 160-71.63 160-160S344.37 0 256 0 96 71.63 96 160s71.63 160 160 160zm-.3-151.94l33.58-78.36c3.5-8.17 12.94-11.92 21.03-8.41 8.12 3.48 11.88 12.89 8.41 21l-33.67 78.55C291.73 188 296 197.45 296 208c0 22.09-17.91 40-40 40s-40-17.91-40-40c0-21.98 17.76-39.77 39.7-39.94z"/></svg>';
const iconoHeart = '<svg width="32" height="32" viewBox="0 0 512 512" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M462.3 62.6C407.5 15.9 326 24.3 275.7 76.2L256 96.5l-19.7-20.3C186.1 24.3 104.5 15.9 49.7 62.6c-62.8 53.6-66.1 149.8-9.9 207.9l193.5 199.8c12.5 12.9 32.8 12.9 45.3 0l193.5-199.8c56.3-58.1 53-154.3-9.8-207.9z"/></svg>';
const iconoBalance = '<svg width="32" height="32" viewBox="0 0 640 512" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M384 32l128 0c17.7 0 32 14.3 32 32s-14.3 32-32 32L398.4 96c-5.2 25.8-22.9 47.1-46.4 57.3l0 294.7 160 0c17.7 0 32 14.3 32 32s-14.3 32-32 32l-384 0c-17.7 0-32-14.3-32-32s14.3-32 32-32l160 0 0-294.7c-23.5-10.3-41.2-31.6-46.4-57.3L128 96c-17.7 0-32-14.3-32-32s14.3-32 32-32l128 0c14.6-19.4 37.8-32 64-32s49.4 12.6 64 32zm55.6 288L584.4 320 512 195.8 439.6 320zM512 416c-62.9 0-115.2-34-126-78.9-2.6-11 1-22.3 6.7-32.1l95.2-163.2c5-8.6 14.2-13.8 24.1-13.8s19.1 5.3 24.1 13.8l95.2 163.2c5.7 9.8 9.3 21.1 6.7 32.1-10.8 44.8-63.1 78.9-126 78.9zM126.8 195.8L54.4 320 199.3 320 126.8 195.8zM.9 337.1c-2.6-11 1-22.3 6.7-32.1l95.2-163.2c5-8.6 14.2-13.8 24.1-13.8s19.1 5.3 24.1 13.8l95.2 163.2c5.7 9.8 9.3 21.1 6.7 32.1-10.8 44.8-63.1 78.9-126 78.9S11.7 382 .9 337.1z"/></svg>';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 24);
---

<BaseLayout
  title="Club de Nutrición — Entiende tu cuerpo, equilibra tus hormonas y recupera tu energía"
  description="Nutrición y bienestar femenino +35 sin dietas extremas. Aprende a nutrirte de forma inteligente para sentirte plena en cada etapa."
>
  <section class="hero">
    <div class="hero-copy">
      <h1>Entiende tu cuerpo, <span class="highlight">equilibra tus hormonas</span> y recupera <span class="highlight">tu energía</span></h1>
      <p class="hero-subtitle">Nutrición y bienestar femenino <strong>+35</strong> sin dietas extremas. Aprende a nutrirte de forma inteligente para sentirte plena en cada etapa.</p>
      <a class="hero-cta" href="/lm-5-pasos-optin/">Descargar guía gratuita</a>
      <a class="hero-cta hero-cta-secundario" href="/blog/">Explorar artículos</a>
    </div>
    <Image class="hero-image" src={heroImg} alt="Club de Nutrición" width={600} height={450} />
  </section>

  <section class="enfoque">
    <h2>Un enfoque diferente para entender tu cuerpo</h2>
    <div class="grid">
      <div class="enfoque-item">
        <div class="enfoque-titulo">
          <span class="icon" aria-hidden="true" set:html={iconoBrain} />
          <h3>Basado en evidencia</h3>
        </div>
        <p>No se trata de modas ni soluciones rápidas, sino de entender cómo funciona tu cuerpo realmente.</p>
      </div>
      <div class="enfoque-item">
        <div class="enfoque-titulo">
          <span class="icon" aria-hidden="true" set:html={iconoWeight} />
          <h3>Sin dietas extremas</h3>
        </div>
        <p>Aquí no encontrarás restricciones imposibles, sino un enfoque sostenible y adaptado a tu día a día.</p>
      </div>
      <div class="enfoque-item">
        <div class="enfoque-titulo">
          <span class="icon" aria-hidden="true" set:html={iconoBalance} />
          <h3>Equilibrio hormonal real</h3>
        </div>
        <p>Trabajamos desde la raíz: hormonas, metabolismo, inflamación y estilo de vida.</p>
      </div>
      <div class="enfoque-item">
        <div class="enfoque-titulo">
          <span class="icon" aria-hidden="true" set:html={iconoHeart} />
          <h3>Para mujeres +35</h3>
        </div>
        <p>Porque tu cuerpo cambia con los años, y necesitas una forma diferente de cuidarte.</p>
      </div>
    </div>
    <p class="enfoque-cierre">Cada vez más mujeres están empezando a entender su cuerpo y a recuperar su energía de forma natural.</p>
  </section>

  <ArticulosRelacionados
    heading="Últimas entradas"
    articulos={posts}
    pageSize={6}
  />

  <CTAFinal
    heading="¿Sientes que tu energía sube y baja constantemente?"
    ctaLabel="Descargar la guía ahora"
    ctaHref="/lm-5-pasos-optin/"
  />
</BaseLayout>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    padding-block: var(--space-section);
  }
  .hero-copy {
    flex: 1 1 320px;
  }
  .hero-copy h1 .highlight {
    color: var(--color-nav-text, #e08325);
  }
  .hero-image {
    flex: 1 1 320px;
    border-radius: 1rem;
  }
  .hero-cta {
    display: inline-block;
    margin-top: 1rem;
    margin-right: 0.75rem;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    background: var(--color-accent, #c2185b);
    color: #fff;
    text-decoration: none;
  }
  .hero-cta-secundario {
    background: transparent;
    color: var(--color-accent, #c2185b);
    border: 1px solid var(--color-accent, #c2185b);
  }
  .enfoque {
    padding-block: var(--space-section);
    text-align: center;
  }
  .enfoque .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .enfoque-item {
    background: #fff;
    border-radius: 1rem;
    /* Sombra más marcada (revisión visual 2026-09-14): la usuaria pidió que
       se note el relieve, la anterior (0.06 de opacidad) era casi
       imperceptible. */
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
    padding: 1.5rem;
  }
  .enfoque-titulo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  .enfoque-item h3 {
    margin: 0;
  }
  .enfoque-item .icon {
    display: inline-flex;
    flex: none;
    color: var(--color-accent, #c2185b);
  }
  .enfoque-item .icon svg {
    width: 2rem;
    height: 2rem;
  }
  .enfoque-cierre {
    margin-top: 1.5rem;
    font-style: italic;
  }
</style>
