---
// Ruta dinámica para artículos de Blog Y publicaciones de Radar de Salud —
// ambos comparten hoy el mismo namespace de URL en la raíz (/{slug}/), así
// que una sola ruta cubre las 82 páginas de contenido, resolviendo contra
// las DOS collections (independientes entre sí en Astro, ver
// src/content.config.ts) y eligiendo la plantilla según de cuál venga.
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import RadarLayout from '../../layouts/RadarLayout.astro';
import RecipeLayout from '../../layouts/RecipeLayout.astro';
import { pickRelacionados } from '../../lib/relacionados';

export async function getStaticPaths() {
  const [blogPosts, radarPosts] = await Promise.all([getCollection('blog'), getCollection('radar')]);

  const blogPaths = blogPosts
    .filter((p) => !p.data.draft)
    .map((entry) => ({ params: { slug: entry.data.slug ?? entry.id }, props: { entry, kind: 'blog' as const } }));

  const radarPaths = radarPosts
    .filter((p) => !p.data.draft)
    .map((entry) => ({ params: { slug: entry.data.slug ?? entry.id }, props: { entry, kind: 'radar' as const } }));

  return [...blogPaths, ...radarPaths];
}

const { entry, kind } = Astro.props;
const { Content, headings } = await render(entry as any);

// Relacionados: misma collection, misma categoría (blog) o cualquier otra
// publicación de Radar (radar), excluyendo la propia entrada, más recientes
// primero — equivalente al widget "posts.cards" filtrado por categoría que
// usa WordPress hoy.
const siblings = (kind === 'blog' ? await getCollection('blog') : await getCollection('radar')).filter(
  (p) => !p.data.draft && p.id !== entry.id,
);

const relacionados =
  kind === 'blog'
    ? pickRelacionados(
        siblings as any,
        (p) => (p.data as any).category === (entry.data as any).category,
        // Hasta 9 (3 páginas de 3, con paginación como en el resto de la web).
        9,
        // Si faltan, se completa con la misma categoría madre (como en las hijas).
        (p) => (p.data as any).category.split('/')[0] === (entry.data as any).category.split('/')[0],
      )
    : // Radar: el resto de publicaciones, más recientes primero, hasta 9 (3
      // páginas de 3 con paginación, como en el resto de la web).
      siblings.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 9);

---

{kind === 'blog' && (entry.data as any).receta ? (
  <RecipeLayout entry={entry as any} relacionados={relacionados}>
    <Content />
  </RecipeLayout>
) : kind === 'blog' ? (
  <ArticleLayout
    entry={entry as any}
    categoria={(entry.data as any).category}
    headings={headings}
    relacionados={relacionados}
  >
    <Content />
  </ArticleLayout>
) : (
  <RadarLayout entry={entry as any} relacionados={relacionados}>
    <Content />
  </RadarLayout>
)}
