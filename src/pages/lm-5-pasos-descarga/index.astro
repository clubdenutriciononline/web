---
// Embudo de la guía "5 pasos" — 3/3: descarga (18 oct, con el formato del
// resto de la web). Textos y enlace de descarga (Google Drive) del original.
// Es el enlace del correo de confirmación del proveedor. Fuera de buscadores.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import SiguenosRedes from '../../components/SiguenosRedes.astro';
import portadaImg from './_images/portada.jpg';

const DESCARGA = 'https://drive.google.com/uc?export=download&id=1KzsTKNKU5CZ-fLZESyNe6rVJvgtZs6Rf';
---

<BaseLayout
  title="Ya puedes descargar tu guía - Club de Nutrición"
  description="Descarga tu guía: 5 pasos para recuperar tu energía y equilibrar tus hormonas."
  noindex
>
  <div class="hub">
    <Hero
      title="Ya puedes descargar tu guía"
      subtitle="Esto no va de hacerlo perfecto. Va de empezar a entender tu cuerpo."
      ctaIntro="Tu acceso está listo. Pulsa el botón para descargar «5 pasos para recuperar tu energía y equilibrar tus hormonas»:"
      ctaLabel="Descargar la guía"
      ctaHref={DESCARGA}
      image={portadaImg}
      imageAlt="Portada de la guía 5 pasos para recuperar tu energía y equilibrar tus hormonas"
      layout="lateral"
      titleSize="hija"
    />

    <section class="recuerda">
      <h2>Recuerda</h2>
      <p>Empieza por un solo paso.</p>
      <p>No necesitas hacerlo todo perfecto.</p>
    </section>

    <div class="full-bleed band-b">
      <section class="siguiente">
        <h2>¿Y ahora qué?</h2>
        <p>Mientras pones en marcha la guía, puedes seguir aprendiendo sobre tu cuerpo en nuestras secciones.</p>
        <div class="enlaces">
          <a href="/hormonas/">Hormonas</a>
          <a href="/energia/">Energía</a>
          <a href="/metabolismo/">Metabolismo</a>
          <a href="/recetas/">Recetas</a>
        </div>
      </section>
    </div>

    <SiguenosRedes />
  </div>
</BaseLayout>

<style>
  /* La portada es vertical: se muestra entera en vez de recortada. */
  .hub :global(.hero[data-layout='lateral'] .hero-image) {
    object-fit: contain;
    background: #fff;
  }
  .recuerda,
  .siguiente {
    max-width: 760px;
    margin-inline: auto;
    padding-block: var(--space-section);
    text-align: center;
  }
  .recuerda h2,
  .siguiente h2 {
    color: #6c2f50;
    text-align: center;
  }
  .recuerda p {
    font-family: var(--font-body);
    font-size: 24px;
    line-height: 39px;
    letter-spacing: 1.3px;
    margin: 0;
  }
  .siguiente p {
    font-family: var(--font-body);
    font-size: 20px;
    line-height: 33px;
  }
  .enlaces {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 1rem;
  }
  .enlaces a {
    background: #fff;
    color: #6c2f50;
    border-radius: 999px;
    padding: 10px 22px;
    font-family: var(--font-heading);
    font-weight: 500;
    text-decoration: none;
    box-shadow: 0 0 8px rgba(0, 0, 0, 0.15);
    transition: background 0.2s, color 0.2s;
  }
  .enlaces a:hover {
    background: #6c2f50;
    color: #fff;
  }
</style>
