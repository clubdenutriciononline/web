---
// Página de resultados de búsqueda (18 oct). Lanza la búsqueda sola con el
// término de la dirección: /buscar/?q=keto. Las etiquetas antiguas de
// WordPress (/tag/<etiqueta>/) redirigen aquí con su palabra (vercel.json),
// así quien llega desde una etiqueta ve las entradas relacionadas. Los guiones
// del slug se buscan como espacios ("ayuno-intermitente" → "ayuno
// intermitente"). Fuera de buscadores y del propio índice de Pagefind.
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Buscar - Club de Nutrición"
  description="Busca en los artículos, recetas y noticias de Club de Nutrición."
  noindex
  buscable={false}
>
  <section class="buscar">
    <h1>Buscar en Club de Nutrición</h1>
    <p class="buscar-intro">Escribe un tema y te mostramos los artículos, recetas y noticias relacionados.</p>
    <div id="buscar-resultados"></div>
  </section>
</BaseLayout>

<script>
  const mount = document.getElementById('buscar-resultados');
  const termino = (new URLSearchParams(location.search).get('q') || '').replace(/-/g, ' ').trim();
  try {
    // @ts-ignore — solo existe en el sitio construido (dist/pagefind/), tras `npm run build`.
    await import(/* @vite-ignore */ '/pagefind/pagefind-ui.js');
    // @ts-ignore
    const ui = new window.PagefindUI({
      element: '#buscar-resultados',
      showSubResults: true,
      showImages: false,
      autofocus: !termino,
      translations: { placeholder: 'Buscar' },
    });
    if (termino) ui.triggerSearch(termino);
  } catch {
    if (mount) {
      mount.textContent =
        'El buscador solo está disponible en la versión publicada del sitio (necesita un build completo, no el modo de desarrollo).';
    }
  }
</script>

<style>
  .buscar {
    max-width: 860px;
    margin-inline: auto;
    padding-block: var(--space-section);
  }
  .buscar h1 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 40px;
    line-height: 1.3;
    color: #6c2f50;
    text-align: center;
    margin: 0 0 0.5rem;
  }
  .buscar-intro {
    font-family: var(--font-body);
    font-size: 20px;
    line-height: 33px;
    text-align: center;
    margin: 0 0 2rem;
  }
  /* Colores de la web en el buscador de Pagefind. */
  #buscar-resultados {
    --pagefind-ui-primary: #6c2f50;
    --pagefind-ui-text: #212121;
    --pagefind-ui-border: #e0cfe0;
    --pagefind-ui-border-radius: 12px;
    --pagefind-ui-font: var(--font-body);
  }
  @media (max-width: 767px) {
    .buscar h1 {
      font-size: 30px;
    }
  }
</style>
