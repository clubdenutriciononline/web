---
// Sección "relación con..." — en el original el texto y las imágenes van
// intercalados (párrafo, imagen a ancho completo, más párrafos, segunda
// imagen, frase de cierre), no texto seguido de una rejilla de miniaturas.
// Por eso el contenido se pasa entero por el slot, en el orden real de la
// página, y el componente solo aporta la sección + el estilo de las
// imágenes sueltas que haya dentro (tarjeta con sombra, sin recorte).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  heading: string;
  // Compatibilidad con páginas aún no revisadas una a una: si se pasan,
  // se añaden al final en una rejilla. Las páginas ya revisadas (Hormonas)
  // intercalan sus imágenes directamente en el slot, en el orden real.
  images?: { src: ImageMetadata; alt: string }[];
  // Justificado (Energía, Metabolismo) o a la izquierda (Hormonas).
  textAlign?: 'justify' | 'left';
}
const { heading, images, textAlign = 'justify' } = Astro.props;
---

<section class="relacion-imagenes" data-align={textAlign}>
  <h2>{heading}</h2>
  <slot />
  {images && images.length > 0 && (
    <div class="legacy-grid">
      {images.map((img) => <Image src={img.src} alt={img.alt} />)}
    </div>
  )}
</section>

<style>
  /* Original: texto Fredoka 20px justificado; el primer párrafo va a
     24px/35px con 1.3px de espaciado y el de cierre a 22px (igual en
     Energía y Metabolismo). */
  .relacion-imagenes {
    padding-block: var(--space-section);
    font-family: var(--font-body);
    font-size: 20px;
    line-height: 33px;
    text-align: justify;
  }
  .relacion-imagenes > :global(p:first-of-type) {
    font-size: 24px;
    line-height: 35px;
    letter-spacing: 1.3px;
    margin-bottom: 11px;
  }
  .relacion-imagenes > :global(p:last-of-type) {
    font-size: 22px;
  }
  .relacion-imagenes[data-align='left'] {
    text-align: left;
  }
  .relacion-imagenes :global(p.lead) {
    text-align: center;
    font-size: 24px;
    letter-spacing: 1.3px;
    margin-block: 0.25rem;
  }
  .relacion-imagenes :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin-block: 1.5rem;
    border-radius: 20px;
    box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);
  }
  .legacy-grid {
    display: grid;
    gap: 1rem;
  }
</style>
