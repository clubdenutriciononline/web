---
import { socialLinks, legalLinks } from '../data/navigation';
import SocialIcon from './SocialIcon.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <img
    src="/images/site/banner-fondo-trans.png"
    alt=""
    width="988"
    height="169"
    class="footer-banner"
  />

  <div class="footer-black">
    <div class="footer-inner">
      <div class="footer-social">
        {socialLinks.map((s) => (
          <a href={s.href} aria-label={s.label} target="_blank" rel="noopener noreferrer">
            <SocialIcon name={s.icon} />
          </a>
        ))}
      </div>

      <hr class="footer-separador" />

      <nav class="footer-legal" aria-label="Enlaces legales">
        <ul>
          {legalLinks.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <hr class="footer-separador" />

      <p class="footer-copy">Copyright © {year} Club de Nutrición</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    text-align: center;
  }
  .footer-black {
    /* Confirmado por captura real: banda negra a ancho completo del
       viewport para redes/legales/copyright — la imagen decorativa
       "banner-fondo-trans" queda fuera, sobre fondo blanco. */
    background: var(--color-footer-bg);
    color: var(--color-footer-text);
  }
  .footer-inner {
    max-width: var(--container-width);
    margin-inline: auto;
    padding: 1.5rem var(--container-padding) 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .footer-legal ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer-legal a {
    /* Color real del original (confirmado por captura y CSS del tema:
       enlaces legales del footer en naranja, no en el gris del resto del
       texto del footer). */
    color: #fc7504;
  }
  .footer-social {
    display: flex;
    gap: 1rem;
    color: #808080;
  }
  .footer-social a {
    /* Sin esto, el <a> hereda el azul de enlace por defecto del navegador
       en vez del gris de .footer-social, porque un <a> sin color propio
       usa el color de enlace del user-agent antes que el heredado. */
    color: inherit;
    display: inline-flex;
  }
  .footer-separador {
    width: 100%;
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    margin: 0;
  }
  .footer-banner {
    /* Tamaño real del original (confirmado por captura): la imagen se
       sirve grande (988px) pero se muestra reducida, no a ancho completo. */
    max-width: 420px;
    width: 100%;
    height: auto;
  }
</style>
