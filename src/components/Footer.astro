---
import { socialLinks, legalLinks } from '../data/navigation';
import SocialIcon from './SocialIcon.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <img
    src="/images/site/banner-fondo-trans.png"
    alt="banner-fondo-trans"
    width="988"
    height="169"
    class="footer-banner"
  />

  <div class="footer-social">
    {socialLinks.map((s) => (
      <a href={s.href} aria-label={s.label} target="_blank" rel="noopener noreferrer">
        <SocialIcon name={s.icon} />
      </a>
    ))}
  </div>

  <nav class="footer-legal" aria-label="Enlaces legales">
    <ul>
      {legalLinks.map((l) => (
        <li><a href={l.href}>{l.label}</a></li>
      ))}
    </ul>
  </nav>

  <p class="footer-copy">Copyright © {year} Club de Nutrición</p>

  <button class="back-to-top" type="button" aria-label="Volver arriba">↑</button>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 2rem 1rem;
    text-align: center;
  }
  .footer-legal ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer-social {
    display: flex;
    gap: 0.75rem;
  }
  .footer-banner {
    max-width: 100%;
    height: auto;
  }
</style>
