---
// Lista de bullets de síntomas (conteo real variable por página).
interface Props {
  heading: string;
  items: string[];
}
const { heading, items } = Astro.props;
---

<div class="full-bleed band-b">
  <section class="lista-sintomas">
    <h2>{heading}</h2>
    <ul>
      {items.map((item) => (
        <li><span class="check" aria-hidden="true">✔</span> {item}</li>
      ))}
    </ul>
  </section>
</div>

<style>
  .lista-sintomas {
    padding-block: var(--space-section);
  }
  .lista-sintomas ul {
    columns: 2;
    list-style: none;
    padding: 0;
    font-family: var(--font-body);
    font-size: 1.125rem;
  }
  .lista-sintomas li {
    break-inside: avoid;
    margin-bottom: 0.75rem;
    color: #6c2f50;
  }
  .lista-sintomas .check {
    display: inline-block;
    width: 1.3rem;
    color: #f964c0;
    font-weight: 600;
  }
  @media (max-width: 640px) {
    .lista-sintomas ul {
      columns: 1;
    }
  }
</style>
