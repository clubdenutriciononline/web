---
// Lista de bullets de síntomas (conteo real variable por página). En el
// original cada pareja de síntomas va dentro de su propia tarjeta con
// sombra (icon-list widget, confirmado por el CSS compilado: fondo casi
// blanco, radio10→20 y sombra que se intensifica al pasar el ratón, icono
// fa-check-circle rosa). Se agrupan los items de 2 en 2 para reproducirlo.
interface Props {
  heading: string;
  subheading?: string;
  items: string[];
}
const { heading, subheading, items } = Astro.props;

const groups: string[][] = [];
for (let i = 0; i < items.length; i += 2) {
  groups.push(items.slice(i, i + 2));
}
---

<div class="full-bleed band-b">
  <section class="lista-sintomas">
    <h2>{heading}</h2>
    {subheading && <p class="subheading">{subheading}</p>}
    <div class="grid">
      {groups.map((group) => (
        <div class="sintoma-card">
          <ul>
            {group.map((item) => (
              <li><span class="check" aria-hidden="true">✔</span> {item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</div>

<style>
  .lista-sintomas {
    padding-block: var(--space-section);
  }
  .subheading {
    text-align: center;
    font-family: var(--font-body);
    font-size: 22px;
    line-height: 33px;
    margin-top: -0.5rem;
    margin-bottom: 1.5rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem 1.5rem;
  }
  .sintoma-card {
    background: rgba(250, 248, 250, 0.5);
    border-radius: 10px;
    box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);
    padding: 0.5rem 1rem;
    transition: border-radius 0.3s, box-shadow 0.3s;
  }
  .sintoma-card:hover {
    border-radius: 20px;
    box-shadow: 10px 10px 10px rgba(0, 0, 0, 0.5);
  }
  .sintoma-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: var(--font-body);
    font-size: 20px;
    line-height: 33px;
  }
  .sintoma-card li {
    margin-block: 0.4rem;
    color: #6c2f50;
  }
  .check {
    display: inline-block;
    width: 1.3rem;
    color: #f964c0;
    font-weight: 600;
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
