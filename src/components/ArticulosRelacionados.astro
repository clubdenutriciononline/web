---
// Bloque "Artículos relacionados". Corrección aplicada durante la migración
// (decisión de la usuaria, 2026-09-12): si no hay artículos para mostrar
// (caso real hoy en /resistencia-insulina/), el componente no renderiza
// nada — nunca se muestra un bloque vacío.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  heading?: string;
  articulos: CollectionEntry<'blog' | 'radar'>[];
}
const { heading = 'Artículos relacionados', articulos } = Astro.props;
---

{articulos.length > 0 && (
  <section class="articulos-relacionados">
    <h2>{heading}</h2>
    <div class="grid">
      {articulos.map((post) => {
        const categoria = 'category' in post.data ? (post.data.category as string) : 'Radar de Salud';
        const categoriaLabel = categoria.split('/').pop()?.replace(/-/g, ' ') ?? categoria;
        return (
          <a class="post-card" href={`/${post.data.slug ?? post.id}/`}>
            <div class="post-image">
              <Image src={post.data.image} alt={post.data.imageAlt} width={320} height={200} />
              <span class="badge">{categoriaLabel}</span>
            </div>
            <img class="avatar" src="/images/site/logo.png" alt="" width="32" height="32" />
            <h3>{post.data.title}</h3>
            <span class="leer-mas">Leer artículo »</span>
          </a>
        );
      })}
    </div>
  </section>
)}

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }
  .post-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .post-image {
    position: relative;
  }
  .post-image :global(img) {
    display: block;
    width: 100%;
    border-radius: 0.5rem;
  }
  .badge {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    background: var(--color-accent, #c2185b);
    color: #fff;
    text-transform: uppercase;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
  }
  .avatar {
    display: block;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    object-fit: cover;
    margin: 0.6rem 0 0.3rem;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.06);
  }
</style>
