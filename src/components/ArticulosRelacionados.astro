---
// Bloque "Artículos relacionados". Corrección aplicada durante la migración
// (decisión de la usuaria, 2026-09-12): si no hay artículos para mostrar
// (caso real hoy en /resistencia-insulina/), el componente no renderiza
// nada — nunca se muestra un bloque vacío.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  heading?: string | false;
  articulos: CollectionEntry<'blog' | 'radar'>[];
  verMasHref?: string;
  verMasLabel?: string;
  // Paginación cliente (revisión visual 2026-09-14, pedida para la Home):
  // en vez de mostrar todos los artículos o un enlace "ver más", se
  // muestran de `pageSize` en `pageSize` con controles « Anterior /
  // Página X de Y / Siguiente » — mismo patrón visual que la paginación
  // real de /blog/, pero sin generar URLs nuevas (todo ocurre en la misma
  // página, con JS). Si no se indica, se muestran todos los artículos.
  pageSize?: number;
}
const {
  heading = 'Artículos relacionados',
  articulos,
  verMasHref,
  verMasLabel = 'Ver todas las entradas »',
  pageSize,
} = Astro.props;
const totalPaginas = pageSize ? Math.max(1, Math.ceil(articulos.length / pageSize)) : 1;
---

{articulos.length > 0 && (
  <section class="articulos-relacionados" data-paginated={pageSize ? 'true' : undefined} data-page-size={pageSize}>
    {heading !== false && <h2>{heading}</h2>}
    <div class="grid">
      {articulos.map((post, i) => {
        const categoria = 'category' in post.data ? (post.data.category as string) : 'Radar de Salud';
        const categoriaLabel = categoria.split('/').pop()?.replace(/-/g, ' ') ?? categoria;
        const oculto = pageSize ? i >= pageSize : false;
        return (
          <a class="post-card" href={`/${post.data.slug ?? post.id}/`} hidden={oculto}>
            <div class="post-image">
              <Image src={post.data.image} alt={post.data.imageAlt} width={320} height={200} />
              <span class="badge">{categoriaLabel}</span>
            </div>
            <img class="avatar" src="/images/site/logo-icono.png" alt="" width="32" height="32" />
            <h3>{post.data.title}</h3>
            <span class="leer-mas">Leer artículo »</span>
          </a>
        );
      })}
    </div>
    {verMasHref && (
      <a class="ver-mas" href={verMasHref}>{verMasLabel}</a>
    )}
    {pageSize && totalPaginas > 1 && (
      <nav class="paginacion-cliente" aria-label="Paginación de artículos">
        <button type="button" class="pag-prev" disabled>« Anterior</button>
        <span class="pag-info">Página <span class="pag-actual">1</span> de {totalPaginas}</span>
        <button type="button" class="pag-next">Siguiente »</button>
      </nav>
    )}
  </section>
)}

<style>
  /* Grid a 3 columnas en escritorio / 2 en tablet / 1 en móvil (revisión
     visual 2026-09-14): el original usa siempre 3 tarjetas de ancho
     completo, nunca 4 — con auto-fit a 4 columnas se desorganizaba el
     grid al reducir el ancho (quedaba 3+3+2 en vez de 2+2+2). */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  .post-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .post-card[hidden] {
    /* Sin esto, `display: block` de arriba gana al `display: none` del
       atributo `hidden` del navegador (misma especificidad, pero el
       estilo del autor pisa al del user-agent) y la paginación cliente no
       oculta nada — todas las tarjetas quedaban visibles. */
    display: none;
  }
  .post-image {
    position: relative;
  }
  .post-image :global(img) {
    display: block;
    width: 100%;
    border-radius: 0.5rem;
  }
  .badge {
    /* Posición pedida por la usuaria (revisión visual 2026-09-14): en el
       original la etiqueta va arriba a la derecha, pero ahí suele quedar
       encima de la cabeza de las personas en muchas fotos — se mueve
       abajo a la derecha a propósito, como excepción a la réplica 1:1. */
    position: absolute;
    bottom: 0.6rem;
    right: 0.6rem;
    background: #f964c0;
    color: #fff;
    text-transform: uppercase;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
  }
  .avatar {
    display: block;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    object-fit: cover;
    margin: 0.6rem 0 0.3rem;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.06);
  }
  .post-card h3 {
    /* Color y tono reales del original (muestreo de captura real,
       revisión visual 2026-09-14). */
    color: #6c2f50;
  }
  .leer-mas {
    display: inline-block;
    color: #f964c0;
    font-weight: 600;
  }
  .ver-mas {
    display: block;
    text-align: center;
    margin-top: 2rem;
    color: var(--color-accent, #c2185b);
    font-weight: 600;
    text-decoration: none;
  }
  .paginacion-cliente {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem 0 0;
  }
  .paginacion-cliente button {
    border: none;
    background: none;
    font: inherit;
    color: var(--color-accent, #c2185b);
    cursor: pointer;
    padding: 0;
  }
  .paginacion-cliente button:disabled {
    color: #bbb;
    cursor: default;
  }
</style>

<script>
  // Paginación cliente del bloque de artículos (ver prop `pageSize`) — sin
  // recargar página ni generar URLs nuevas. Cada instancia se inicializa
  // de forma independiente por si el componente se usa varias veces.
  document.querySelectorAll<HTMLElement>('.articulos-relacionados[data-paginated="true"]').forEach((section) => {
    const pageSize = Number(section.dataset.pageSize);
    if (!pageSize) return;
    const cards = [...section.querySelectorAll<HTMLElement>('.post-card')];
    const totalPaginas = Math.max(1, Math.ceil(cards.length / pageSize));
    const nav = section.querySelector('.paginacion-cliente');
    const prevBtn = nav?.querySelector<HTMLButtonElement>('.pag-prev');
    const nextBtn = nav?.querySelector<HTMLButtonElement>('.pag-next');
    const pagActual = nav?.querySelector('.pag-actual');
    let actual = 1;

    function render() {
      cards.forEach((card, i) => {
        const pagina = Math.floor(i / pageSize) + 1;
        card.hidden = pagina !== actual;
      });
      if (pagActual) pagActual.textContent = String(actual);
      if (prevBtn) prevBtn.disabled = actual === 1;
      if (nextBtn) nextBtn.disabled = actual === totalPaginas;
    }

    prevBtn?.addEventListener('click', () => {
      if (actual > 1) {
        actual -= 1;
        render();
        section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
    nextBtn?.addEventListener('click', () => {
      if (actual < totalPaginas) {
        actual += 1;
        render();
        section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    render();
  });
</script>
