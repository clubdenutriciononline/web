---
// Nota (revisión visual 2026-09-14): se retiran los iconos de redes
// sociales del encabezado por decisión de la usuaria — el original los
// tiene, pero en Astro se decide no mostrarlos aquí (ya están en el
// footer).
// Cabecera fija al hacer scroll (2026-10-17): el original la mantiene
// visible al bajar (comprobado en /metabolismo/). Distribución pedida por
// la usuaria: logo a la izquierda y, a su derecha, menú en una línea con
// el buscador (más pequeño) debajo, pegado a la derecha y a la altura de
// la base del logo. 
// Móvil (20 oct): menú hamburguesa con los desplegables de cada sección
// (botón con flecha para abrirlos sin perder el enlace a la sección),
// buscador dentro del menú y cabecera fija también en móvil.
// Dos filas (2026-10-17, pedido de la usuaria): arriba solo las páginas de
// tema (Inicio … Alimentación, y Recetas cuando exista); abajo el buscador a
// la izquierda, justo bajo "Inicio", y Blog · Radar de Salud · Contacto a la
// derecha, terminando en el mismo borde que el menú.
import { mainNav } from '../data/navigation';

const secundarias = ['/blog/', '/radar-de-salud/', '/quienes-somos/'];
const menu = mainNav.filter((item) => !secundarias.includes(item.href));
const menuSecundario = mainNav.filter((item) => secundarias.includes(item.href));
---

<header class="site-header" data-pagefind-ignore="all">
  <div class="site-header-inner">
    <div class="header-top">
      <a href="/" class="logo">
        <img src="/images/site/logo.png" width="166" height="69" alt="Club de Nutrición" />
      </a>

      <button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="header-menus">
        <span></span><span></span><span></span>
      </button>

      <div class="header-menus" id="header-menus">
      <nav class="main-nav" aria-label="Menú principal">
        <ul>
          {menu.map((item) => (
            <li class:list={['nav-item', { 'has-children': item.children }]}>
              <a href={item.href}>
                {item.label}
                {item.children && (
                  <svg class="chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                )}
              </a>
              {item.children && (
                <button class="submenu-toggle" type="button" aria-expanded="false" aria-label={`Ver apartados de ${item.label}`}>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
              )}
              {item.children && (
                <ul class="dropdown">
                  {item.children.map((child) => (
                    <li><a href={child.href}>{child.label}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <div class="header-search-inline">
        <input type="search" class="search-input" placeholder="Buscar" aria-label="Buscar" readonly />
        <button id="search-toggle" class="search-toggle" type="button" aria-label="Buscar" aria-expanded="false" aria-controls="header-search">
          Buscar
        </button>
      </div>
      <nav class="nav-secundario" aria-label="Blog, Radar de Salud y Contacto">
        <ul>
          {menuSecundario.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
      </div>
    </div>

    <div id="header-search" class="header-search" hidden>
      <!--
        Buscador: Pagefind (client-side, sin backend). Indexa Blog + Radar de
        Salud conjuntamente porque ambas collections generan páginas HTML
        estáticas normales bajo /{slug}/ — Pagefind rastrea el HTML construido,
        no distingue entre collections, así que ambos tipos de contenido
        aparecen juntos en los resultados de forma natural.
        El índice solo existe tras `npm run build` (postbuild: pagefind --site
        dist) — en `astro dev` esta caja se monta pero no encontrará
        /pagefind/pagefind-ui.js hasta que exista un build.
      -->
      <div id="pagefind-search"></div>
    </div>
  </div>
</header>

<style>
  .site-header {
    /* Confirmado por captura real: banda de cabecera con degradado verde
       claro a ancho completo de viewport (no acotada al contenedor). */
    background: linear-gradient(180deg, var(--color-header-bg-from) 0%, var(--color-header-bg-to) 100%);
  }
  .site-header-inner {
    max-width: var(--container-width);
    margin-inline: auto;
    padding-inline: var(--container-padding);
    padding-block: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .main-nav ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  .main-nav > ul > li > a {
    color: var(--color-nav-text);
    text-transform: uppercase;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .nav-item {
    position: relative;
  }
  /* Desplegable medido en el original (Astra): 250px, fondo blanco, línea
     naranja de 2px arriba, sombra suave; cada opción Rubik 16px naranja
     con 14.4px/16px de relleno y una línea gris debajo; verde al pasar el
     ratón, sin subrayado. */
  .nav-item .dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 10;
    list-style: none;
    margin: 0;
    padding: 0;
    width: 250px;
    background: #fff;
    border-top: 2px solid var(--color-nav-text);
    box-shadow: 0 4px 10px -2px rgba(0, 0, 0, 0.1);
  }
  .nav-item.has-children > a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .chevron {
    width: 12px;
    height: 12px;
  }
  .nav-item.has-children:hover .dropdown,
  .nav-item.has-children:focus-within .dropdown {
    display: block;
  }
  .nav-item .dropdown a {
    display: block;
    padding: 14.4px 16px;
    border-bottom: 1px solid #eaeaea;
    font-family: 'Rubik', sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 23.2px;
    color: var(--color-nav-text);
    text-transform: none;
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-item .dropdown a:hover,
  .nav-item .dropdown a:focus-visible {
    color: #6cb70c;
  }
  .header-search-inline {
    display: flex;
    align-items: stretch;
    gap: 0;
  }
  /* Mismo aspecto que las opciones del menú principal. */
  .nav-secundario ul {
    display: flex;
    gap: 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-secundario a {
    color: var(--color-nav-text);
    text-transform: uppercase;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .header-menus {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .search-input {
    border: 1px solid #ddd;
    border-radius: 4px 0 0 4px;
    padding: 0.3rem 0.6rem;
    font: inherit;
    font-size: 0.85rem;
    width: 150px;
    cursor: pointer;
  }
  .search-toggle {
    border: none;
    border-radius: 0 4px 4px 0;
    padding: 0.3rem 0.8rem;
    font-size: 0.85rem;
    background: var(--color-nav-text);
    color: #fff;
    font-weight: 600;
    cursor: pointer;
  }
  .header-search {
    padding: 0.5rem 0 1rem;
  }

  /* Al final para que pise a las reglas base de .header-top/.main-nav. */
  @media (min-width: 1200px) {
    .site-header {
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
    }
    /* Algo más ancha que el contenido (1140px) para que el menú quepa en
       una línea; el original ocupa todo el ancho de la ventana. */
    .site-header-inner {
      max-width: 1280px;
    }
    .header-top {
      display: grid;
      grid-template-columns: auto 1fr;
      grid-template-rows: auto auto;
      column-gap: 2rem;
      row-gap: 0.4rem;
    }
    .header-top .logo {
      grid-column: 1;
      grid-row: 1 / 3;
      align-self: center;
    }
    /* Bloque de menús ajustado al ancho de la fila del menú y pegado a la
       derecha: así el buscador empieza justo bajo "Inicio" y Contacto
       termina en el mismo borde que la última opción del menú. */
    .header-menus {
      grid-column: 2;
      grid-row: 1 / 3;
      justify-self: end;
      align-self: stretch;
      display: grid;
      grid-template-rows: auto auto;
      grid-template-columns: auto auto;
      justify-content: space-between;
      align-content: space-between;
      row-gap: 0.4rem;
    }
    .main-nav {
      grid-column: 1 / 3;
      grid-row: 1;
      padding-top: 0.4rem;
    }
    .header-top .logo img {
      display: block;
      width: 166px;
      max-width: none;
      height: auto;
    }
    .main-nav > ul {
      gap: 0.4rem 1.1rem;
      justify-content: flex-end;
    }
    .main-nav > ul > li > a {
      white-space: nowrap;
    }
    .header-search-inline {
      grid-column: 1;
      grid-row: 2;
      justify-self: start;
      align-self: end;
      padding-bottom: 0.3rem;
    }
    .nav-secundario {
      grid-column: 2;
      grid-row: 2;
      justify-self: end;
      align-self: center;
      padding-bottom: 0.3rem;
    }
  }
  /* El menú solo cabe en una línea a partir de ~1200px; por debajo pasa a
     dos líneas en vez de desbordar o aplastar el logo. */
  @media (min-width: 1200px) {
    .main-nav > ul {
      flex-wrap: nowrap;
    }
  }
  .menu-toggle,
  .submenu-toggle {
    display: none;
  }

  /* Móvil y tablet (hasta 1199px, donde el menú ya no cabe en una línea;
     20 y 25 oct): cabecera fija, logo + hamburguesa; el menú se abre
     debajo con las secciones en lista y sus apartados plegables. */
  @media (max-width: 1199px) {
    .site-header {
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    }
    .site-header-inner {
      padding-block: 0.5rem;
      gap: 0;
    }
    .header-top {
      flex-wrap: wrap;
      row-gap: 0;
    }
    .header-top .logo img {
      display: block;
      width: 120px;
      height: auto;
    }
    .menu-toggle {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 44px;
      height: 44px;
      padding: 10px;
      border: 0;
      border-radius: 8px;
      background: transparent;
      cursor: pointer;
    }
    .menu-toggle span {
      display: block;
      height: 3px;
      border-radius: 2px;
      background: var(--color-nav-text);
      transition: transform 0.2s, opacity 0.2s;
    }
    .site-header.menu-abierto .menu-toggle span:nth-child(1) {
      transform: translateY(8px) rotate(45deg);
    }
    .site-header.menu-abierto .menu-toggle span:nth-child(2) {
      opacity: 0;
    }
    .site-header.menu-abierto .menu-toggle span:nth-child(3) {
      transform: translateY(-8px) rotate(-45deg);
    }
    .header-menus {
      display: none;
    }
    .site-header.menu-abierto .header-menus {
      flex-basis: 100%;
      display: flex;
      flex-direction: column;
      gap: 0;
      max-height: calc(100vh - 80px);
      overflow-y: auto;
      padding: 0.5rem 0 1rem;
    }
    .header-search-inline {
      order: -1;
      margin-bottom: 0.5rem;
    }
    .search-input {
      flex: 1;
      width: auto;
      font-size: 16px;
      padding: 0.5rem 0.7rem;
    }
    .search-toggle {
      font-size: 16px;
      padding: 0.5rem 1rem;
    }
    .main-nav ul,
    .nav-secundario ul {
      flex-direction: column;
      gap: 0;
    }
    .main-nav > ul > li,
    .nav-secundario li {
      border-bottom: 1px solid #eaeaea;
    }
    .nav-item.has-children {
      display: grid;
      grid-template-columns: 1fr 44px;
      align-items: center;
    }
    .main-nav > ul > li > a,
    .nav-secundario a {
      display: block;
      padding: 12px 4px;
      font-size: 16px;
    }
    .main-nav .chevron {
      display: none;
    }
    .submenu-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border: 0;
      background: transparent;
      color: var(--color-nav-text);
      cursor: pointer;
    }
    .submenu-toggle svg {
      width: 18px;
      height: 18px;
      transition: transform 0.2s;
    }
    .nav-item.abierto .submenu-toggle svg {
      transform: rotate(180deg);
    }
    /* Los apartados no se abren al pasar el dedo: solo con la flecha. */
    .nav-item.has-children:hover .dropdown,
    .nav-item.has-children:focus-within .dropdown {
      display: none;
    }
    .nav-item .dropdown,
    .nav-item.abierto:hover .dropdown,
    .nav-item.abierto:focus-within .dropdown {
      position: static;
      grid-column: 1 / 3;
      width: auto;
      border-top: 0;
      box-shadow: none;
      background: transparent;
      padding: 0 0 6px 14px;
    }
    .nav-item.has-children.abierto .dropdown,
    .nav-item.has-children.abierto:hover .dropdown,
    .nav-item.has-children.abierto:focus-within .dropdown {
      display: block;
    }
    .nav-item .dropdown a {
      padding: 10px 4px;
      font-size: 16px;
      border-bottom: 0;
    }
  }
</style>

<script>
  // Menú móvil: hamburguesa y apartados plegables.
  const cabecera = document.querySelector('.site-header');
  const botonMenu = document.querySelector('.menu-toggle');
  botonMenu?.addEventListener('click', () => {
    const abierto = cabecera?.classList.toggle('menu-abierto') ?? false;
    botonMenu.setAttribute('aria-expanded', String(abierto));
    botonMenu.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
  });
  document.querySelectorAll('.submenu-toggle').forEach((b) => {
    b.addEventListener('click', () => {
      const abierto = b.parentElement?.classList.toggle('abierto') ?? false;
      b.setAttribute('aria-expanded', String(abierto));
    });
  });

  const toggle = document.getElementById('search-toggle');
  const searchInput = document.querySelector('.search-input');
  const panel = document.getElementById('header-search');
  let pagefindMounted = false;

  searchInput?.addEventListener('click', () => toggle?.dispatchEvent(new Event('click')));

  toggle?.addEventListener('click', async () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    if (panel) panel.hidden = expanded;
    if (!expanded && cabecera?.classList.contains('menu-abierto')) {
      cabecera.classList.remove('menu-abierto');
      botonMenu?.setAttribute('aria-expanded', 'false');
    }

    if (!expanded && !pagefindMounted) {
      pagefindMounted = true;
      try {
        // @ts-ignore — solo existe en el sitio construido (dist/pagefind/), tras `npm run build`.
        await import(/* @vite-ignore */ '/pagefind/pagefind-ui.js');
        // @ts-ignore
        new window.PagefindUI({ element: '#pagefind-search', showSubResults: true, showImages: false });
      } catch {
        const mount = document.getElementById('pagefind-search');
        if (mount) {
          mount.textContent =
            'El buscador solo está disponible en la versión publicada del sitio (necesita un build completo, no el modo de desarrollo).';
        }
      }
    }
  });
</script>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
