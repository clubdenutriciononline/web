---
// Lista numerada con círculos de color de marca — confirmada en Cortisol
// (causas/soluciones) y Perimenopausia (solución natural). Sustituye la
// numeración de texto plano "1. 2. 3." por el badge circular del original.
interface Item {
  title?: string; // parte en negrita al inicio del punto, si la hay
  text: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<ol class="numbered-list">
  {items.map((item) => (
    <li>
      <span class="numbered-badge" aria-hidden="true"></span>
      <span class="numbered-text">
        {item.title && <strong>{item.title}</strong>}
        {item.title && ' — '}
        {item.text}
      </span>
    </li>
  ))}
</ol>

<style>
  .numbered-list {
    list-style: none;
    margin: 1rem 0;
    padding: 0;
    counter-reset: numbered;
    display: grid;
    gap: 0.85rem;
  }
  .numbered-list li {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    counter-increment: numbered;
  }
  .numbered-badge {
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    background: var(--color-accent, #c2185b);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.85rem;
  }
  .numbered-badge::before {
    content: counter(numbered);
  }
  .numbered-text {
    line-height: 1.55;
    padding-top: 0.15rem;
  }
</style>
