---
// Icon set genérico propio (no son los SVG exactos del tema Astra original,
// que son inline/propietarios del tema — no descargables), usado para que
// los enlaces sociales se muestren como iconos, tal como en el original,
// en vez de como texto plano.
interface Props {
  name: 'facebook' | 'x' | 'instagram' | 'pinterest' | 'facebook-group';
}
const { name } = Astro.props;
---

{name === 'facebook' && (
  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
    <path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12Z" />
  </svg>
)}
{name === 'x' && (
  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
    <path d="M18.9 3H22l-7.6 8.7L23 21h-6.6l-5.2-6.4L5.3 21H2.2l8.1-9.3L1.6 3h6.8l4.7 5.9L18.9 3Zm-1.1 16.2h1.7L7.3 4.7H5.5l12.3 14.5Z" />
  </svg>
)}
{name === 'instagram' && (
  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <rect x="3" y="3" width="18" height="18" rx="5" />
    <circle cx="12" cy="12" r="4" />
    <circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none" />
  </svg>
)}
{name === 'pinterest' && (
  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
    <path d="M12 2a10 10 0 0 0-3.6 19.3c0-.8 0-1.8.2-2.6l1.4-6s-.3-.7-.3-1.7c0-1.6.9-2.8 2.1-2.8 1 0 1.5.7 1.5 1.6 0 1-.6 2.4-.9 3.8-.3 1.1.6 2 1.7 2 2.1 0 3.5-2.6 3.5-5.7 0-2.4-1.6-4.1-4.5-4.1-3.3 0-5.3 2.4-5.3 5.1 0 .9.3 1.6.7 2.1.2.2.2.3.1.5l-.3 1c-.1.3-.3.4-.6.3-1.4-.6-2.1-2.3-2.1-4.1 0-3.1 2.6-6.7 7.6-6.7 4.1 0 6.8 2.9 6.8 6.1 0 4.2-2.4 7.3-5.9 7.3-1.2 0-2.3-.6-2.6-1.4l-.7 2.8c-.3 1-.9 2.1-1.4 2.9A10 10 0 1 0 12 2Z" />
  </svg>
)}
{name === 'facebook-group' && (
  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <circle cx="9" cy="8" r="3" />
    <path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6" />
    <circle cx="17" cy="9" r="2.2" />
    <path d="M15.5 20c.2-2.6 2-4.7 4.5-4.9" />
  </svg>
)}
