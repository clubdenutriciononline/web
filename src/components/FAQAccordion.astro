---
// Acordeón de Preguntas Frecuentes — único de /inflamacion-hormonal/
// (SubpageBlogPost). Usa <details>/<summary> nativos: accesible y sin JS.
interface FAQ {
  question: string;
  answer: string;
}
interface Props {
  heading?: string;
  items: FAQ[];
  id?: string;
}
const { heading = 'Preguntas Frecuentes', items, id } = Astro.props;
---

<section class="faq-accordion" id={id}>
  <h2>{heading}</h2>
  {items.map((item) => (
    <details>
      <summary>{item.question}</summary>
      <p>{item.answer}</p>
    </details>
  ))}
</section>

<style>
  .faq-accordion details {
    border-bottom: 1px solid #eee;
    padding: 1rem 0;
  }
  .faq-accordion summary {
    cursor: pointer;
    font-weight: 600;
  }
</style>
