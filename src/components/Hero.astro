---
// Hero de hub/subpágina. Siempre renderiza un <h1> real (corrección aplicada
// durante la migración, ver 00-analisis/02-mapa-migracion.md sección 9) aunque
// visualmente se mantenga idéntico al diseño actual.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  subtitle?: string;
  // Línea corta justo encima del botón (p. ej. "Descubre cómo estabilizar
  // tu energía, descarga la guía ahora:"), confirmada por el CSS compilado
  // del original como un segundo text-editor independiente del subtítulo.
  ctaIntro?: string;
  ctaLabel?: string;
  ctaHref?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  // 'side' (por defecto): imagen a la derecha, texto a la izquierda
  // (Hormonas). 'stacked': imagen a ancho completo arriba y el texto
  // debajo en media columna — confirmado como el patrón real de Energía
  // en el HTML del original (hero = imagen suelta a ancho completo +
  // sección aparte debajo con el texto). No todos los hubs usan el mismo.
  layout?: 'side' | 'stacked';
}

const { title, subtitle, ctaIntro, ctaLabel, ctaHref, image, imageAlt, layout = 'side' } = Astro.props;
---

<div class="full-bleed band-a">
  <section class="hero" data-layout={layout}>
    {image && (
      <div class="hero-image-wrap">
        <Image class="hero-image" src={image} alt={imageAlt ?? ''} />
      </div>
    )}
    <div class="hero-copy">
      <h1>{title}</h1>
      {subtitle && <p class="hero-subtitle">{subtitle}</p>}
      {ctaIntro && <p class="hero-cta-intro">{ctaIntro}</p>}
      {ctaLabel && ctaHref && (
        <a class="hero-cta" href={ctaHref}>{ctaLabel}</a>
      )}
    </div>
  </section>
</div>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: nowrap;
    padding-block: var(--space-section);
  }
  .hero-copy {
    flex: 0 1 60%;
    order: 2;
  }
  .hero-image-wrap {
    flex: 0 1 40%;
    text-align: right;
    order: 3;
  }
  .hero-image {
    width: 73%;
    height: auto;
    border-radius: 20px;
    box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);
    transition: transform 0.3s;
  }

  /* Patrón "stacked" (Energía): imagen suelta a ancho completo arriba,
     texto debajo en media columna. */
  .hero[data-layout='stacked'] {
    flex-direction: column;
    align-items: stretch;
  }
  .hero[data-layout='stacked'] .hero-image-wrap {
    flex: 1 1 100%;
    text-align: center;
    order: 1;
  }
  .hero[data-layout='stacked'] .hero-image {
    width: 100%;
  }
  .hero[data-layout='stacked'] .hero-copy {
    flex: 1 1 100%;
    max-width: 50%;
    order: 2;
  }
  .hero-image:hover {
    transform: scale(1.1);
  }
  .hero-subtitle {
    font-family: var(--font-body);
    font-size: 1.25rem;
    font-weight: 500;
    color: rgba(33, 33, 33, 0.79);
  }
  .hero-cta-intro {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text);
  }
  .hero-cta {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.75rem 1.5rem;
    border-radius: 20px;
    background: #6c2f50;
    color: #fff;
    font-family: var(--font-body);
    font-weight: 500;
    box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);
    text-decoration: none;
  }
  h1 {
    font-size: 3rem;
    letter-spacing: -0.5px;
  }

  @media (max-width: 767px) {
    .hero {
      flex-wrap: wrap;
    }
    .hero-copy,
    .hero-image-wrap {
      flex: 1 1 100%;
      max-width: 100%;
      text-align: left;
    }
    .hero-image {
      width: 100%;
    }
    h1 {
      font-size: 1.75rem;
    }
  }
</style>
