---
// Hero de hub/subpágina. Siempre renderiza un <h1> real (corrección aplicada
// durante la migración, ver 00-analisis/02-mapa-migracion.md sección 9) aunque
// visualmente se mantenga idéntico al diseño actual.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  subtitle?: string;
  // Línea corta justo encima del botón (p. ej. "Descubre cómo estabilizar
  // tu energía, descarga la guía ahora:"), confirmada por el CSS compilado
  // del original como un segundo text-editor independiente del subtítulo.
  ctaIntro?: string;
  ctaLabel?: string;
  ctaHref?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  // 'side' (por defecto): imagen a la derecha, texto a la izquierda
  // (Hormonas). 'overlay': imagen a ancho completo con una tarjeta de
  // texto semitransparente superpuesta en la esquina inferior izquierda
  // — confirmado como el patrón real de Energía en el CSS del original
  // (columna de texto con background-color:#FFFFFF70 y margin-top
  // negativo que la monta sobre la imagen). No todos los hubs son iguales.
  // 'lateral': hero de las páginas hija (medido en Fatiga crónica y Ciclo
  // menstrual): texto a la izquierda (662px) y foto cuadrada de 418px a la
  // derecha, con radio 20px y sombra.
  layout?: 'side' | 'overlay' | 'lateral';
  // 'display' (por defecto): titular grande de 48px (Hormonas, Energía).
  // 'lead': cuando el original no tiene titular en el hero sino una frase
  // larga en un text-editor (Metabolismo: Rubik 26px/500 #212121, 24px en
  // tablet/móvil, widget b60edae del CSS post-3580) — a 48px desbordaba la
  // imagen y tapaba el menú. Se mantiene el <h1> por SEO.
  // 'medio': frase larga a Rubik 400 38px/55px, gris al 79% (Microbiota).
  // 'seccion': titular a Rubik 500 32px #000 con subtítulo Fredoka 500
  // 22px #212121 (Mentalidad: el titular es un H2 de Elementor).
  // 'frase': hijas sin titular visible (Fatiga crónica): la frase del hero
  // en Fredoka 500 26px/50px, gris al 79%. Sigue siendo el <h1>.
  titleSize?: 'display' | 'lead' | 'medio' | 'seccion' | 'frase';
}

// 'overlay' es el patrón real en 4 de las 5 páginas madre (Energía,
// Metabolismo, Microbiota, Mentalidad); Hormonas es la única excepción
// con el hero "side" — por eso es el valor por defecto aquí, y
// HubTemplateA (solo Hormonas) pasa layout="side" explícitamente.
const { title, subtitle, ctaIntro, ctaLabel, ctaHref, image, imageAlt, layout = 'overlay', titleSize = 'display' } = Astro.props;
---

<div class="full-bleed band-a">
  <section class="hero" data-layout={layout} data-title-size={titleSize}>
    {image && (
      <div class="hero-image-wrap">
        <Image class="hero-image" src={image} alt={imageAlt ?? ''} />
      </div>
    )}
    <div class="hero-copy">
      <h1 data-size={titleSize}>{title}</h1>
      {subtitle && <p class="hero-subtitle">{subtitle}</p>}
      {ctaIntro && <p class="hero-cta-intro">{ctaIntro}</p>}
      {ctaLabel && ctaHref && (
        <a class="hero-cta" href={ctaHref}>{ctaLabel}</a>
      )}
    </div>
  </section>
</div>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: nowrap;
    padding-block: var(--space-section);
  }
  .hero-copy {
    flex: 0 1 60%;
    order: 2;
  }
  .hero-image-wrap {
    flex: 0 1 40%;
    text-align: right;
    order: 3;
  }
  .hero-image {
    width: 73%;
    height: auto;
    border-radius: 20px;
    box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);
    transition: transform 0.3s;
  }

  /* Patrón "overlay" (Energía): imagen a ancho completo con una tarjeta
     de texto semitransparente superpuesta en la esquina inferior
     izquierda, fiel al margin-top negativo + background-color:#FFFFFF70
     del original. */
  .hero[data-layout='overlay'] {
    display: block;
    position: relative;
  }
  .hero[data-layout='overlay'] .hero-image-wrap {
    display: block;
  }
  .hero[data-layout='overlay'] .hero-image {
    width: 100%;
  }
  .hero[data-layout='overlay'] .hero-copy {
    position: absolute;
    left: 0;
    bottom: 8%;
    /* 681px de ancho medidos en el original (Energía, Metabolismo). */
    width: 61%;
    max-width: 681px;
    background: rgba(255, 255, 255, 0.7);
    border-radius: 0 20px 20px 0;
    padding: 2rem;
  }
  .hero-image:hover {
    transform: scale(1.1);
  }
  .hero-subtitle {
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 500;
    color: rgba(33, 33, 33, 0.79);
  }
  /* Overlay (Energía): subtítulo 400 #212121 — Hormonas (side) lo lleva a 500. */
  .hero[data-layout='overlay'] .hero-subtitle {
    font-weight: 400;
    color: #212121;
  }
  .hero-cta-intro {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    color: rgba(33, 33, 33, 0.79);
  }
  .hero-cta {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.75rem 1.5rem;
    border-radius: 20px;
    background: #6c2f50;
    color: #fff;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 500;
    line-height: 1;
    box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);
    text-decoration: none;
  }
  h1 {
    font-size: 3rem;
    line-height: 1.4;
    letter-spacing: -0.5px;
    margin: 0 0 16px;
  }
  /* Titular del hero overlay (Energía): Rubik 500 48px/57px #000, -0.7px. */
  .hero[data-layout='overlay'] h1[data-size='display'] {
    font-weight: 500;
    line-height: 57px;
    letter-spacing: -0.7px;
    color: #000;
  }
  h1[data-size='lead'] {
    font-size: 26px;
    font-weight: 500;
    line-height: 33px;
    margin-bottom: 26px;
    letter-spacing: normal;
    color: #212121;
  }
  h1[data-size='frase'] {
    font-family: var(--font-body);
    font-size: 26px;
    font-weight: 500;
    line-height: 50px;
    letter-spacing: normal;
    color: rgba(33, 33, 33, 0.79);
    margin-bottom: 45px;
  }
  .hero[data-layout='lateral'] {
    display: grid;
    grid-template-columns: minmax(0, 662px) 418px;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding-block: 12px;
  }
  .hero[data-layout='lateral'] .hero-copy {
    order: 1;
  }
  .hero[data-layout='lateral'] .hero-image-wrap {
    order: 2;
  }
  .hero[data-layout='lateral'] .hero-image {
    display: block;
    width: 418px;
    height: 418px;
    object-fit: cover;
  }
  h1[data-size='seccion'] {
    font-size: 32px;
    font-weight: 500;
    line-height: 41.6px;
    letter-spacing: normal;
    color: #000;
  }
  .hero[data-title-size='seccion'] .hero-subtitle {
    font-size: 22px;
    font-weight: 500;
    line-height: 33px;
  }
  h1[data-size='medio'] {
    font-size: 38px;
    font-weight: 400;
    line-height: 55px;
    letter-spacing: normal;
    color: rgba(33, 33, 33, 0.79);
    margin-bottom: 40px;
  }
  @media (max-width: 1024px) {
    h1[data-size='lead'] {
      font-size: 24px;
    }
  }

  @media (max-width: 767px) {
    .hero {
      flex-wrap: wrap;
    }
    .hero-copy,
    .hero-image-wrap {
      flex: 1 1 100%;
      max-width: 100%;
      text-align: left;
    }
    .hero-image {
      width: 100%;
    }
    h1 {
      font-size: 1.75rem;
    }
    h1[data-size='lead'] {
      font-size: 1.25rem;
    }
    .hero[data-layout='lateral'] {
      display: block;
    }
    .hero[data-layout='lateral'] .hero-image {
      width: 100%;
      height: auto;
      aspect-ratio: 1;
    }
    h1[data-size='frase'] {
      font-size: 1.25rem;
      line-height: 1.6;
    }
    h1[data-size='seccion'] {
      font-size: 1.5rem;
      line-height: 1.3;
    }
    h1[data-size='medio'] {
      font-size: 1.5rem;
      line-height: 1.4;
    }
    .hero[data-layout='overlay'] .hero-copy {
      position: static;
      width: 100%;
      max-width: 100%;
      margin-top: 1rem;
      border-radius: 20px;
      background: #fff;
    }
  }
</style>
