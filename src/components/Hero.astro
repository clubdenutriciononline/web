---
// Hero de hub/subpágina. Siempre renderiza un <h1> real (corrección aplicada
// durante la migración, ver 00-analisis/02-mapa-migracion.md sección 9) aunque
// visualmente se mantenga idéntico al diseño actual.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  subtitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { title, subtitle, ctaLabel, ctaHref, image, imageAlt } = Astro.props;
---

<section class="hero">
  <div class="hero-copy">
    <h1>{title}</h1>
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
    {ctaLabel && ctaHref && (
      <a class="hero-cta" href={ctaHref}>{ctaLabel}</a>
    )}
  </div>
  {image && <Image class="hero-image" src={image} alt={imageAlt ?? ''} width={600} height={450} />}
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    padding: 2rem 1rem;
  }
  .hero-copy {
    flex: 1 1 320px;
  }
  .hero-image {
    flex: 1 1 320px;
    border-radius: 1rem;
  }
  .hero-cta {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    background: var(--color-accent, #c2185b);
    color: #fff;
    text-decoration: none;
  }
</style>
