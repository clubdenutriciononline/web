---
// Mini-headings de "soluciones"/"pilares". En el sitio original hay dos
// variantes reales: "chip" (cajas pequeñas rosa pastel, sin icono —
// Hormonas "Cómo equilibrar", Menopausia "Soluciones Prácticas") y "card"
// (tarjetas blancas con icono, más grandes — Inflamación hormonal
// "Soluciones"). El prop `body` sigue siendo opcional porque el original a
// veces solo lleva título.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Solucion {
  title: string;
  body?: string;
  // string = emoji; ImageMetadata = imagen real descargada; { svg } = icono
  // vectorial inline (para cuando el original usa una fuente de iconos como
  // Material Design Icons/IcoFont/Font Awesome en vez de una imagen o emoji
  // real — se reproduce el SVG del icono concreto sin cargar la librería).
  icon?: string | ImageMetadata | { svg: string };
}
interface Props {
  heading?: string;
  // Pregunta en negrita antes del subheading (Metabolismo: "¿Qué puedes
  // hacer para apoyar un metabolismo saludable?").
  lead?: string;
  subheading?: string;
  soluciones: Solucion[];
  // Solo con 5 items en variant="card": '3-2' (por defecto, Energía) o
  // '2-3' (2 arriba más anchas y 3 abajo, Metabolismo).
  layout5?: '3-2' | '2-3';
  // 'texto': Fredoka 22px/33px (síntomas). 'destacado': 24px/39px con
  // 1.3px de espaciado (bloque de soluciones de Energía y Metabolismo).
  subheadingVariant?: 'texto' | 'destacado';
  subheadingAlign?: 'justify' | 'center';
  // Texto de las tarjetas "card": centrado (soluciones) o a la izquierda
  // (síntomas de Energía en el original).
  cardAlign?: 'center' | 'left';
  // 'plain': lista simple de título + texto, sin tarjeta ni icono
  // (síntomas de Energía en el original: h4 Fredoka 500 27px #6C2F50).
  variant?: 'chip' | 'card' | 'pill' | 'plain';
  // Banda de fondo con degradado (ver BaseLayout .band-a / .band-b),
  // confirmada por sección en el CSS compilado del original. Opcional:
  // cada página decide si esta fila concreta cae dentro de una banda o no.
  band?: 'a' | 'b' | false;
}
const { heading, lead, subheading, soluciones, variant = 'chip', band = false, layout5 = '3-2', subheadingVariant = 'texto', subheadingAlign = 'justify', cardAlign = 'center' } = Astro.props;
---

<section data-variant={variant} data-sub={subheadingVariant} data-align={subheadingAlign} data-card-align={cardAlign} class:list={['soluciones', band && 'full-bleed', band === 'a' && 'band-a', band === 'b' && 'band-b']}>
  <div class="soluciones-inner">
    {heading && <h2>{heading}</h2>}
    {lead && <p class="subheading lead"><strong>{lead}</strong></p>}
    {subheading && <p class="subheading">{subheading}</p>}
    <div class="grid" data-count={soluciones.length} data-layout5={layout5}>
      {soluciones.map((s) => (
        <div class="solucion-item">
          {s.icon && (
            typeof s.icon === 'string'
              ? <span class="icon" aria-hidden="true">{s.icon}</span>
              : 'svg' in s.icon
                ? <span class="icon icon-svg" aria-hidden="true" set:html={s.icon.svg} />
                : <Image class="icon-img" src={s.icon} alt="" width={64} height={64} />
          )}
          <h3>{s.title}</h3>
          {s.body && <p>{s.body}</p>}
        </div>
      ))}
    </div>
    <slot />
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }
  .solucion-item {
    background: var(--color-surface-alt, #fdf2f7);
    border-radius: 0.75rem;
    padding: 1rem;
  }
  .icon {
    font-size: 1.75rem;
  }
  .icon-img {
    width: 64px;
    height: 64px;
    object-fit: contain;
  }
  .icon-svg {
    display: inline-flex;
    color: var(--color-accent, #c2185b);
  }
  /* :global porque el SVG llega por set:html y no recibe el atributo de
     ámbito de Astro — sin esto el icono se dibuja a todo el ancho. */
  .icon-svg :global(svg) {
    width: 29px;
    height: 29px;
  }

  /* Variante "card": tarjetas blancas con sombra + icono, para grids de
     soluciones más elaborados (ej. Inflamación hormonal). */
  section[data-variant='card'] .grid {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }
  section[data-variant='card'] .solucion-item {
    background: linear-gradient(150deg, #fdf2f7 0%, #f3e8f0 100%);
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
    border-radius: 10px;
    padding: 20px;
    text-align: center;
    transition: border-radius 0.3s, box-shadow 0.3s;
  }
  section[data-variant='card'] .solucion-item:hover {
    border-radius: 20px;
    box-shadow: 10px 10px 10px rgba(0, 0, 0, 0.5);
  }
  section[data-variant='card'] .icon-img,
  section[data-variant='card'] .icon,
  section[data-variant='card'] .icon-svg {
    display: flex;
    justify-content: center;
    margin: 0 auto 0.5rem;
  }
  /* Original (icon-box): icono 50px, título Rubik 500 24px #6C2F50 con
     20px debajo, texto Fredoka 20px/33px. */
  section[data-variant='card'] .icon {
    font-size: 50px;
    line-height: 1;
  }
  section[data-variant='card'] .icon-svg :global(svg) {
    width: 50px;
    height: 50px;
  }
  section[data-variant='card'] h3 {
    font-size: 24px;
    font-weight: 500;
    color: #6c2f50;
    margin: 0 0 20px;
  }
  section[data-card-align='left'] .solucion-item p {
    text-align: left;
  }
  section[data-variant='card'] .solucion-item p {
    font-family: var(--font-body);
    font-size: 20px;
    line-height: 33px;
    margin: 0;
  }

  /* 5 soluciones: 3 tarjetas arriba (más verticales) y 2 abajo (más
     anchas, ocupando entre las dos el mismo ancho que las 3 de arriba) —
     patrón real confirmado en el original (col-33 x3 + col-50 x2). */
  section[data-variant='card'] .grid[data-count='5'] {
    grid-template-columns: repeat(6, 1fr);
  }
  section[data-variant='card'] .grid[data-count='5'] .solucion-item:nth-child(1) {
    grid-column: 1 / 3;
  }
  section[data-variant='card'] .grid[data-count='5'] .solucion-item:nth-child(2) {
    grid-column: 3 / 5;
  }
  section[data-variant='card'] .grid[data-count='5'] .solucion-item:nth-child(3) {
    grid-column: 5 / 7;
  }
  section[data-variant='card'] .grid[data-count='5'] .solucion-item:nth-child(4) {
    grid-column: 1 / 4;
  }
  section[data-variant='card'] .grid[data-count='5'] .solucion-item:nth-child(5) {
    grid-column: 4 / 7;
  }
  section[data-variant='card'] .grid[data-count='5'][data-layout5='2-3'] .solucion-item:nth-child(1) {
    grid-column: 1 / 4;
  }
  section[data-variant='card'] .grid[data-count='5'][data-layout5='2-3'] .solucion-item:nth-child(2) {
    grid-column: 4 / 7;
  }
  section[data-variant='card'] .grid[data-count='5'][data-layout5='2-3'] .solucion-item:nth-child(3) {
    grid-column: 1 / 3;
  }
  section[data-variant='card'] .grid[data-count='5'][data-layout5='2-3'] .solucion-item:nth-child(4) {
    grid-column: 3 / 5;
  }
  section[data-variant='card'] .grid[data-count='5'][data-layout5='2-3'] .solucion-item:nth-child(5) {
    grid-column: 5 / 7;
  }
  @media (max-width: 900px) {
    section[data-variant='card'] .grid[data-count='5'] {
      grid-template-columns: 1fr;
    }
    section[data-variant='card'] .grid[data-count='5'] .solucion-item {
      grid-column: auto !important;
    }
  }

  .soluciones-inner {
    padding-block: var(--space-section);
  }
  .subheading {
    text-align: justify;
    font-family: var(--font-body);
    font-size: 22px;
    line-height: 33px;
  }
  section[data-sub='destacado'] .subheading {
    font-size: 24px;
    line-height: 39px;
    letter-spacing: 1.3px;
    margin-bottom: 15px;
  }
  section[data-align='center'] .subheading {
    text-align: center;
  }
  .subheading.lead {
    margin-bottom: 0;
  }
  @media (max-width: 767px) {
    .subheading,
    section[data-sub='destacado'] .subheading {
      font-size: 18px;
      line-height: 1.7;
      letter-spacing: 0.4px;
    }
  }

  /* Variante "plain" (síntomas de Energía): lista a ancho completo. */
  section[data-variant='plain'] .grid {
    display: block;
  }
  section[data-variant='plain'] .solucion-item {
    background: none;
    border-radius: 0;
    padding: 0;
    margin-bottom: 2.5rem;
  }
  section[data-variant='plain'] h3 {
    font-family: var(--font-body);
    font-size: 27px;
    font-weight: 500;
    line-height: 1.3;
    color: #6c2f50;
    margin: 0 0 20px;
  }
  section[data-variant='plain'] .solucion-item p {
    font-family: var(--font-body);
    font-size: 20px;
    line-height: 33px;
    margin: 0;
  }

  /* Variante "pill": fila de píldoras con icono (confirmada por el CSS
     compilado del original, widget icon-box — mismo patrón para las
     "píldoras de síntomas" del hero y los "pilares clave" de más abajo). */
  section[data-variant='pill'] .grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
  section[data-variant='pill'] .solucion-item {
    flex: 1 1 160px;
    max-width: 220px;
    background: transparent;
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
    padding: 10px;
    text-align: center;
    transition: border-radius 0.3s, box-shadow 0.3s;
  }
  /* 7 píldoras: 4 arriba y 3 abajo, más anchas (col-25 x4 + col-33 x3 en
     el original, Metabolismo). */
  section[data-variant='pill'] .grid[data-count='7'] {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
  }
  section[data-variant='pill'] .grid[data-count='7'] .solucion-item {
    grid-column: span 3;
    max-width: none;
  }
  section[data-variant='pill'] .grid[data-count='7'] .solucion-item:nth-child(n + 5) {
    grid-column: span 4;
  }
  @media (max-width: 767px) {
    section[data-variant='pill'] .grid[data-count='7'] {
      grid-template-columns: repeat(2, 1fr);
    }
    section[data-variant='pill'] .grid[data-count='7'] .solucion-item,
    section[data-variant='pill'] .grid[data-count='7'] .solucion-item:nth-child(n + 5) {
      grid-column: auto;
    }
  }
  section[data-variant='pill'] .solucion-item:hover {
    border-radius: 20px;
    box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);
  }
  section[data-variant='pill'] .icon {
    font-size: 29px;
    display: block;
  }
  section[data-variant='pill'] h3 {
    font-family: 'Rubik', sans-serif;
    font-size: 24px;
    line-height: 1.3;
    font-weight: 500;
    color: #6c2f50;
    text-transform: none;
    margin: 0.5rem 0 0;
  }
  section[data-variant='pill'] .solucion-item:hover h3 {
    color: #6c2f50;
  }
  section[data-variant='pill'] p {
    font-family: var(--font-body);
    color: #212121;
  }
</style>
