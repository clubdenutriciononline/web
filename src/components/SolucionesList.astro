---
// Mini-headings de "soluciones"/"pilares". En el sitio original hay dos
// variantes reales: "chip" (cajas pequeñas rosa pastel, sin icono —
// Hormonas "Cómo equilibrar", Menopausia "Soluciones Prácticas") y "card"
// (tarjetas blancas con icono, más grandes — Inflamación hormonal
// "Soluciones"). El prop `body` sigue siendo opcional porque el original a
// veces solo lleva título.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Solucion {
  title: string;
  body?: string;
  // string = emoji; ImageMetadata = imagen real descargada; { svg } = icono
  // vectorial inline (para cuando el original usa una fuente de iconos como
  // Material Design Icons/IcoFont/Font Awesome en vez de una imagen o emoji
  // real — se reproduce el SVG del icono concreto sin cargar la librería).
  icon?: string | ImageMetadata | { svg: string };
}
interface Props {
  heading?: string;
  subheading?: string;
  soluciones: Solucion[];
  variant?: 'chip' | 'card' | 'pill';
  // Banda de fondo con degradado (ver BaseLayout .band-a / .band-b),
  // confirmada por sección en el CSS compilado del original. Opcional:
  // cada página decide si esta fila concreta cae dentro de una banda o no.
  band?: 'a' | 'b' | false;
}
const { heading, subheading, soluciones, variant = 'chip', band = false } = Astro.props;
---

<section data-variant={variant} class:list={['soluciones', band && 'full-bleed', band === 'a' && 'band-a', band === 'b' && 'band-b']}>
  <div class="soluciones-inner">
    {heading && <h2>{heading}</h2>}
    {subheading && <p class="subheading">{subheading}</p>}
    <div class="grid">
      {soluciones.map((s) => (
        <div class="solucion-item">
          {s.icon && (
            typeof s.icon === 'string'
              ? <span class="icon" aria-hidden="true">{s.icon}</span>
              : 'svg' in s.icon
                ? <span class="icon icon-svg" aria-hidden="true" set:html={s.icon.svg} />
                : <Image class="icon-img" src={s.icon} alt="" width={64} height={64} />
          )}
          <h3>{s.title}</h3>
          {s.body && <p>{s.body}</p>}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }
  .solucion-item {
    background: var(--color-surface-alt, #fdf2f7);
    border-radius: 0.75rem;
    padding: 1rem;
  }
  .icon {
    font-size: 1.75rem;
  }
  .icon-img {
    width: 64px;
    height: 64px;
    object-fit: contain;
  }
  .icon-svg {
    display: inline-flex;
    color: var(--color-accent, #c2185b);
  }
  .icon-svg svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  /* Variante "card": tarjetas blancas con sombra + icono, para grids de
     soluciones más elaborados (ej. Inflamación hormonal). */
  section[data-variant='card'] .grid {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }
  section[data-variant='card'] .solucion-item {
    background: #fff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    padding: 1.5rem;
    text-align: center;
  }
  section[data-variant='card'] .icon-img,
  section[data-variant='card'] .icon,
  section[data-variant='card'] .icon-svg {
    display: flex;
    justify-content: center;
    margin: 0 auto 0.5rem;
  }

  .soluciones-inner {
    padding-block: var(--space-section);
  }
  .subheading {
    text-align: center;
    font-family: var(--font-body);
    font-size: 1.25rem;
    margin-top: -0.5rem;
  }

  /* Variante "pill": fila de píldoras con icono (confirmada por el CSS
     compilado del original, widget icon-box — mismo patrón para las
     "píldoras de síntomas" del hero y los "pilares clave" de más abajo). */
  section[data-variant='pill'] .grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
  section[data-variant='pill'] .solucion-item {
    flex: 1 1 160px;
    max-width: 220px;
    background: transparent;
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
    padding: 10px;
    text-align: center;
    transition: border-radius 0.3s, box-shadow 0.3s;
  }
  section[data-variant='pill'] .solucion-item:hover {
    border-radius: 20px;
    box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);
  }
  section[data-variant='pill'] .icon {
    font-size: 29px;
    display: block;
  }
  section[data-variant='pill'] h3 {
    font-family: 'Rubik', sans-serif;
    font-size: 1.25rem;
    font-weight: 500;
    color: #6c2f50;
    text-transform: none;
    margin: 0.5rem 0 0;
  }
  section[data-variant='pill'] .solucion-item:hover h3 {
    color: #6c2f50;
  }
  section[data-variant='pill'] p {
    font-family: var(--font-body);
    color: #212121;
  }
</style>
