---
// Grid final "Explora cada área clave" / "Temas relacionados" / "Áreas
// clave relacionadas". En la web original estas tarjetas NO llevan enlace
// (comprobado con captura de pantalla real) pero usan el mismo formato que
// tarjetas sí navegables del sitio, y cada una nombra una página existente.
// Corrección aplicada durante la migración (decisión de la usuaria,
// 2026-09-12, ver 00-analisis/02-mapa-migracion.md sección 9): ahora SÍ
// llevan <a href> real hacia la página correspondiente, que ya existe en
// la arquitectura actual (no se crean páginas nuevas).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Tema {
  icon: string | ImageMetadata; // emoji (string) o imagen real importada vía astro:assets
  title: string;
  text: string;
  href: string; // URL ya existente en la arquitectura (hub o subpágina)
}
interface Props {
  heading: string;
  temas: Tema[];
}
const { heading, temas } = Astro.props;
---

<section class="temas-relacionados">
  <h2>{heading}</h2>
  <div class="grid">
    {temas.map((t) => (
      <a class="tema-card" href={t.href}>
        {typeof t.icon === 'string'
          ? <span class="icon" aria-hidden="true">{t.icon}</span>
          : (
            <span class="icon-img-wrap">
              <Image class="icon-img" src={t.icon} alt="" width={400} height={400} />
            </span>
          )}
        <h3>{t.title}</h3>
        <p>{t.text}</p>
      </a>
    ))}
  </div>
</section>

<style>
  /* El original NO es una rejilla de 2 columnas a partes iguales: cada fila
     son 5 columnas del 20% (vacía, tarjeta, vacía, tarjeta, vacía), así que
     cada tarjeta ocupa solo una quinta parte del contenedor (~228px sobre
     1140px), con grandes márgenes a los lados — confirmado en el HTML del
     original (elementor-col-20 x5, columnas 1/3/5 vacías). Se reproduce
     con grid-column fijo en vez de replicar las 5 columnas literalmente. */
  .grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    row-gap: 2.5rem;
  }
  .tema-card:nth-child(odd) {
    grid-column: 2;
  }
  .tema-card:nth-child(even) {
    grid-column: 4;
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
      row-gap: 1.5rem;
    }
    .tema-card:nth-child(odd),
    .tema-card:nth-child(even) {
      grid-column: auto;
    }
  }
  .tema-card {
    display: block;
    background: #fff;
    border-radius: 20px;
    box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);
    padding: 20px 5px;
    text-align: center;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.3s ease;
  }
  .tema-card:hover,
  .tema-card:focus-visible {
    box-shadow: 10px 10px 10px rgba(0, 0, 0, 0.5);
  }
  .tema-card:hover h3,
  .tema-card:focus-visible h3 {
    color: #ac6ec1;
  }
  .icon {
    font-size: 2rem;
  }
  .icon-img-wrap {
    display: block;
    overflow: hidden;
    width: 77%;
    aspect-ratio: 6 / 7;
    margin: 0 auto;
    border-radius: 20px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
  }
  .icon-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }
  .tema-card:hover .icon-img {
    transform: scale(1.1);
  }
  .tema-card h3 {
    margin-top: 10px;
    font-size: 1.125rem;
    color: #6c2f50;
    transition: color 0.3s;
  }
  .tema-card p {
    margin-top: 0.4rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.4;
  }
</style>
