---
// Grid final "Explora cada área clave" / "Temas relacionados" / "Áreas
// clave relacionadas". En la web original estas tarjetas NO llevan enlace
// (comprobado con captura de pantalla real) pero usan el mismo formato que
// tarjetas sí navegables del sitio, y cada una nombra una página existente.
// Corrección aplicada durante la migración (decisión de la usuaria,
// 2026-09-12, ver 00-analisis/02-mapa-migracion.md sección 9): ahora SÍ
// llevan <a href> real hacia la página correspondiente, que ya existe en
// la arquitectura actual (no se crean páginas nuevas).
// Revisión 18 oct (usuaria): en las páginas madre se mantienen los enlaces a
// sus hijas; en las hijas ("Áreas clave relacionadas") van SIN enlace hasta
// que exista el artículo del blog de cada área, por eso `href` es opcional.
//
// Dos patrones reales confirmados en el CSS compilado del original, según
// el número de tarjetas (varía por página, no todas tienen las mismas):
// - 3 tarjetas (Energía, Metabolismo, Microbiota, Mentalidad — hubs B):
//   3 columnas iguales en una sola fila, sin huecos (elementor-col-33 x3).
// - 4 tarjetas (Hormonas — hub A): 2 filas de 2, cada tarjeta ocupa solo
//   ~32% del contenedor con huecos a los lados (columnas 15%/32%/7.2%/32%).
// No se fuerza el recorte de las fotos: el original deja que la imagen
// se escale a su proporción natural (no hay crop/object-fit en el CSS
// real), así que aquí tampoco se impone un aspect-ratio inventado.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Tema {
  icon: string | ImageMetadata; // emoji (string) o imagen real importada vía astro:assets
  title: string;
  text: string;
  href?: string; // URL existente (madres) o, en hijas, el artículo cuando exista
}
interface Props {
  heading?: string; // opcional: la página puede poner su propio título e intro
  temas: Tema[];
}
const { heading, temas } = Astro.props;
import { emojiComoImagen } from '../lib/emoji';
---

<section class="temas-relacionados">
  {heading && <h2>{heading}</h2>}
  <div class="grid" data-count={temas.length}>
    {temas.map((t) => (
      <Fragment>
        {t.href ? (
          <a class="tema-card" href={t.href}>
            {typeof t.icon === 'string'
              ? <span class="icon" aria-hidden="true">{t.icon}</span>
              : <Image class="icon-img" src={t.icon} alt="" width={600} />}
            <h3 set:html={emojiComoImagen(t.title)} />
            <p>{t.text}</p>
          </a>
        ) : (
          <div class="tema-card sin-enlace">
            {typeof t.icon === 'string'
              ? <span class="icon" aria-hidden="true">{t.icon}</span>
              : <Image class="icon-img" src={t.icon} alt="" width={600} />}
            <h3 set:html={emojiComoImagen(t.title)} />
            <p>{t.text}</p>
          </div>
        )}
      </Fragment>
    ))}
  </div>
</section>

<style>
  /* Patrón por defecto: 3 columnas iguales (el caso más común en los hubs
     tipo B). */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  /* Patrón de 4 tarjetas (Hormonas): 2 filas de 2, tarjetas estrechas con
     huecos a los lados — ancho real medido en el HTML del original. */
  .grid[data-count='4'] {
    grid-template-columns: 15% 32% 7.2% 32% 1fr;
    row-gap: 2.5rem;
  }
  .grid[data-count='4'] .tema-card:nth-child(odd) {
    grid-column: 2;
  }
  .grid[data-count='4'] .tema-card:nth-child(even) {
    grid-column: 4;
  }
  @media (max-width: 640px) {
    .grid[data-count='4'] {
      grid-template-columns: 1fr;
      row-gap: 1.5rem;
    }
    .grid[data-count='4'] .tema-card:nth-child(odd),
    .grid[data-count='4'] .tema-card:nth-child(even) {
      grid-column: auto;
    }
  }

  .tema-card {
    display: block;
    background: #fff;
    border-radius: 20px;
    box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);
    padding: 20px;
    text-align: center;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.3s ease;
  }
  .grid[data-count='4'] .tema-card {
    padding: 20px 5px;
  }
  a.tema-card:hover,
  a.tema-card:focus-visible {
    box-shadow: 10px 10px 10px rgba(0, 0, 0, 0.5);
  }
  a.tema-card:hover h3,
  a.tema-card:focus-visible h3 {
    color: #ac6ec1;
  }
  .icon {
    font-size: 2rem;
  }
  .icon-img {
    display: block;
    width: 77%;
    height: auto;
    margin: 0 auto 0.75rem;
    border-radius: 20px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
    transition: transform 0.3s;
  }
  a.tema-card:hover .icon-img {
    transform: scale(1.1);
  }
  /* Original (image-box): título Rubik 600 26px, texto Fredoka 20px/33px;
     el H2 de esta sección sí va en mayúsculas (text-transform). */
  .temas-relacionados h2 {
    text-transform: uppercase;
    text-align: center;
  }
  /* Emojis del original como imagen (src/lib/emoji.ts), del tamaño del texto. */
  .tema-card h3 :global(img.emoji) {
    display: inline-block;
    width: 1em;
    height: 1em;
    margin: 0 0.15em 0 0;
    vertical-align: -0.12em;
  }
  .tema-card h3 {
    margin: 10px 0;
    font-size: 26px;
    font-weight: 600;
    color: #6c2f50;
    transition: color 0.3s;
  }
  .tema-card p {
    margin: 0;
    font-family: var(--font-body);
    font-size: 20px;
    line-height: 33px;
  }
</style>
