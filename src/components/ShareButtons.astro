---

<div class="share-buttons">
  {links.map((l) => (
    <a href={l.href} target="_blank" rel="noopener noreferrer" aria-label={`Compartir en ${l.label}`} style={`--share-color:${l.color}`}>
      <svg viewBox={l.viewBox} width="18" height="18" fill="#fff" aria-hidden="true"><path d={l.path} /></svg>
    </a>
  ))}
</div>

<style>
  .share-buttons {
    display: flex;
    gap: 0.6rem;
    margin-block: 1rem;
  }
  .share-buttons a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: var(--share-color, var(--color-accent, #c2185b));
    transition: transform 0.15s ease;
  }
  .share-buttons a:hover,
  .share-buttons a:focus-visible {
    transform: translateY(-2px);
  }
</style>
