---
// Botones de compartir — presentes en artículos de Radar de Salud,
// ausentes en artículos de Blog normal (diferencia real confirmada).
// El original los muestra como iconos circulares de color; se reproduce
// aquí con SVG inline en vez de texto plano.
interface Props {
  url: string;
  title: string;
}
const { url, title } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

