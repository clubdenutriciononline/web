---
// Tarjeta interactiva de viñetas con check, en dos columnas — patrón real
// del original (icon-list widget fa-check dentro de una sección con
// radio20 y sombra que se intensifica al pasar el ratón). Se repite en
// varias páginas madre con textos distintos ("¿qué vas a entender?", "en
// esta sección aprenderás", etc.), de ahí que sea un componente aparte en
// vez de repetir el CSS en cada página.
// Un item puede llevar título en negrita ("Aumento de peso: ...", como el
// bloque de síntomas de Metabolismo). `columns={1}` para las listas que en
// el original van en una sola columna (Metabolismo).
type Item = string | { title: string; text: string };
// Icono real del original: fa-check (listas "en esta sección...") o
// fa-check-circle (bloque de síntomas), rosa a 29px.
interface Props {
  items: Item[];
  columns?: 1 | 2;
  icon?: 'check' | 'check-circle';
}
const { items, columns = 2, icon = 'check' } = Astro.props;
const svg = icon === 'check'
  ? '<svg viewBox="0 0 512 512" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M173.898 439.404l-166.4-166.4c-9.997-9.997-9.997-26.206 0-36.204l36.203-36.204c9.997-9.998 26.207-9.998 36.204 0L192 312.69 432.095 72.596c9.997-9.997 26.207-9.997 36.204 0l36.203 36.204c9.997 9.997 9.997 26.206 0 36.204l-294.4 294.401c-9.998 9.997-26.207 9.997-36.204-.001z"/></svg>'
  : '<svg viewBox="0 0 512 512" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M504 256c0 136.967-111.033 248-248 248S8 392.967 8 256 119.033 8 256 8s248 111.033 248 248zM227.314 387.314l184-184c6.248-6.248 6.248-16.379 0-22.627l-22.627-22.627c-6.248-6.249-16.379-6.249-22.628 0L216 308.118l-70.059-70.059c-6.248-6.248-16.379-6.248-22.628 0l-22.627 22.627c-6.248 6.248-6.248 16.379 0 22.627l104 104c6.249 6.249 16.379 6.249 22.628.001z"/></svg>';
---

<div class="checklist-card" data-columns={columns}>
  <ul>
    {items.map((item) => (
      <li>
        <span class="check" aria-hidden="true" set:html={svg} />
        <span>{typeof item === 'string' ? item : <><strong>{item.title}:</strong> {item.text}</>}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  /* Dos columnas que se rellenan de arriba abajo (3 arriba y 2 abajo si
     hay 5 items, 2 y 2 si hay 4, etc.), como en el original — por eso se
     usa columnas CSS en vez de una rejilla, que repartiría los items en
     zigzag entre ambas columnas. */
  .checklist-card {
    columns: 2;
    column-gap: 2rem;
    background: #fff;
    border-radius: 20px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
    padding: 1.5rem 2rem;
    margin-top: 1rem;
    transition: box-shadow 0.3s;
  }
  .checklist-card[data-columns='1'] {
    columns: 1;
  }
  .checklist-card:hover {
    box-shadow: 10px 10px 10px rgba(0, 0, 0, 0.5);
  }
  .checklist-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  /* Original (icon-list): Fredoka 20px/33px #6C2F50, alineado a la
     izquierda con 30px de margen, 20px entre items, check rosa de 29px. */
  .checklist-card ul {
    margin-left: 30px;
  }
  .checklist-card li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    text-align: left;
    font-family: var(--font-body);
    font-size: 20px;
    line-height: 33px;
    color: #6c2f50;
    padding-block: 10px;
    break-inside: avoid;
  }
  .check {
    flex: 0 0 29px;
    display: inline-flex;
    height: 33px;
    align-items: center;
    color: #f964c0;
  }
  .check :global(svg) {
    width: 29px;
    height: 29px;
  }
  @media (max-width: 640px) {
    .checklist-card {
      columns: 1;
    }
    .checklist-card ul {
      margin-left: 0;
    }
    .checklist-card li {
      font-size: 18px;
    }
    .check,
    .check :global(svg) {
      flex-basis: 20px;
      width: 20px;
    }
  }
</style>
