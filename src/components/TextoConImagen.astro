---
// Bloque genérico texto + imagen, reutilizado en secciones tipo
// "¿Qué son las hormonas?", "Definición y contexto", etc.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  heading: string;
  image?: ImageMetadata;
  imageAlt?: string;
  reverse?: boolean;
  // Justificado (Energía, Metabolismo) o a la izquierda (Hormonas).
  textAlign?: 'justify' | 'left';
}
const { heading, image, imageAlt, reverse = false, textAlign = 'justify' } = Astro.props;
---

<div class="full-bleed band-b">
  <section class:list={['texto-imagen', { reverse }]} data-align={textAlign}>
    <!-- Revisión 2026-10-17 (pedido de la usuaria): el H2 ocupa todo el ancho
         y la imagen "flota" a la derecha bajo él; el texto la rodea y, al
         acabarse su altura, continúa a todo el ancho por debajo, en vez de
         dejar una columna de texto mucho más larga que la imagen. -->
    <h2>{heading}</h2>
    <div class="texto-imagen-copy">
      {image && (
        <div class="texto-imagen-image-wrap">
          <Image src={image} alt={imageAlt ?? ''} />
        </div>
      )}
      <slot />
    </div>
  </section>
</div>

<style>
  .texto-imagen {
    padding-block: var(--space-section);
  }
  .texto-imagen h2 {
    text-align: left;
  }
  /* Texto Fredoka 20px justificado (Hormonas: a la izquierda). */
  .texto-imagen-copy {
    display: flow-root;
    font-family: var(--font-body);
    font-size: 20px;
    line-height: 33px;
    text-align: justify;
  }
  [data-align='left'] .texto-imagen-copy {
    text-align: left;
  }
  /* Imagen intercalada en el texto (sin prop `image`), a ancho completo
     — Metabolismo coloca la infografía en mitad del bloque "¿Qué es...?". */
  .texto-imagen-copy :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin-block: 1.5rem;
    border-radius: 20px;
    box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);
  }
  .texto-imagen-image-wrap {
    float: right;
    width: calc(50% - 1rem);
    margin: 0 0 1.5rem 2rem;
  }
  .texto-imagen.reverse .texto-imagen-image-wrap {
    float: left;
    margin: 0 2rem 1.5rem 0;
  }
  .texto-imagen-image-wrap :global(img) {
    margin: 0;
  }
  @media (max-width: 767px) {
    .texto-imagen-image-wrap,
    .texto-imagen.reverse .texto-imagen-image-wrap {
      float: none;
      width: 100%;
      margin: 0 0 1.5rem;
    }
  }
</style>
