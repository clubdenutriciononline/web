---
// Bloque genérico texto + imagen, reutilizado en secciones tipo
// "¿Qué son las hormonas?", "Definición y contexto", etc.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  heading: string;
  image?: ImageMetadata;
  imageAlt?: string;
  reverse?: boolean;
  // Justificado (Energía, Metabolismo) o a la izquierda (Hormonas).
  textAlign?: 'justify' | 'left';
}
const { heading, image, imageAlt, reverse = false, textAlign = 'justify' } = Astro.props;
---

<div class="full-bleed band-b">
  <section class:list={['texto-imagen', { reverse }]} data-align={textAlign}>
    <div class="texto-imagen-copy">
      <h2>{heading}</h2>
      <slot />
    </div>
    {image && (
      <div class="texto-imagen-image-wrap">
        <Image src={image} alt={imageAlt ?? ''} />
      </div>
    )}
  </section>
</div>

<style>
  .texto-imagen {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    flex-wrap: wrap;
    padding-block: var(--space-section);
  }
  .texto-imagen.reverse {
    flex-direction: row-reverse;
  }
  /* "¿Qué es...?": el H2 va alineado a la izquierda (el único así en
     las madres) y el texto Fredoka 20px justificado. */
  .texto-imagen-copy {
    flex: 1 1 320px;
    font-family: var(--font-body);
    font-size: 20px;
    line-height: 33px;
    text-align: justify;
  }
  .texto-imagen-copy h2 {
    text-align: left;
  }
  [data-align='left'] .texto-imagen-copy {
    text-align: left;
  }
  /* Imagen intercalada en el texto (sin prop `image`), a ancho completo
     — Metabolismo coloca la infografía en mitad del bloque "¿Qué es...?". */
  .texto-imagen-copy :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin-block: 1.5rem;
    border-radius: 20px;
    box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);
  }
  .texto-imagen-image-wrap {
    flex: 1 1 320px;
  }
  .texto-imagen-image-wrap :global(img) {
    width: 100%;
    height: auto;
    border-radius: 20px;
    box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);
  }
</style>
