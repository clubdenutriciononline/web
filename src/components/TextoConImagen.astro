---
// Bloque genérico texto + imagen, reutilizado en secciones tipo
// "¿Qué son las hormonas?", "Definición y contexto", etc.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  heading: string;
  image?: ImageMetadata;
  imageAlt?: string;
  reverse?: boolean;
}
const { heading, image, imageAlt, reverse = false } = Astro.props;
---

<div class="full-bleed band-b">
  <section class:list={['texto-imagen', { reverse }]}>
    <div class="texto-imagen-copy">
      <h2>{heading}</h2>
      <slot />
    </div>
    {image && (
      <div class="texto-imagen-image-wrap">
        <Image src={image} alt={imageAlt ?? ''} />
      </div>
    )}
  </section>
</div>

<style>
  .texto-imagen {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    flex-wrap: wrap;
    padding-block: var(--space-section);
  }
  .texto-imagen.reverse {
    flex-direction: row-reverse;
  }
  .texto-imagen-copy {
    flex: 1 1 320px;
    font-family: var(--font-body);
    font-size: 1.125rem;
  }
  .texto-imagen-image-wrap {
    flex: 1 1 320px;
  }
  .texto-imagen-image-wrap :global(img) {
    width: 100%;
    height: auto;
    border-radius: 20px;
    box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);
  }
</style>
