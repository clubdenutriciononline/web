---
interface Props {
  heading: string;
  ctaLabel: string;
  ctaHref: string;
}
const { heading, ctaLabel, ctaHref } = Astro.props;
---

<section class="cta-final">
  <h2>{heading}</h2>
  <a href={ctaHref}>{ctaLabel}</a>
</section>

<style>
  .cta-final {
    text-align: center;
    padding: 2.5rem 1rem;
    background: var(--color-accent-soft, #f7d9e6);
    border-radius: 1rem;
  }
  .cta-final a {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    background: var(--color-accent, #c2185b);
    color: #fff;
    text-decoration: none;
  }
</style>
