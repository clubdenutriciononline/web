---
// Grid de "causas" (u otro tema en grid de tarjetas icono+título+texto).
// El conteo real varía por página (6 es lo más común, pero hay páginas con
// 8) — se respeta el conteo real de cada página, no se fuerza a 6.
// El icono admite emoji (string, se renderiza como texto) o una imagen real
// importada vía astro:assets (ImageMetadata, se renderiza con <Image>) — en
// el sitio original la mayoría de estas tarjetas usan imagen real, no emoji.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Causa {
  icon?: string | ImageMetadata;
  title: string;
  text: string;
}
interface Props {
  heading: string;
  // Pregunta en negrita entre el H2 y el subheading (Metabolismo: "¿Por qué
  // el metabolismo puede ralentizarse?").
  lead?: string;
  // Uno o varios párrafos.
  subheading?: string | string[];
  // H3 antes del subheading y antes de la rejilla (Sueño).
  subtitulo?: string;
  subtituloLista?: string;
  // Justificado por defecto (Energía, Metabolismo); Hormonas lo centra.
  subheadingAlign?: 'justify' | 'center';
  causas: Causa[];
}
const { heading, lead, subheading, subtitulo, subtituloLista, subheadingAlign = 'justify', causas } = Astro.props;
const parrafos = subheading ? (Array.isArray(subheading) ? subheading : [subheading]) : [];
---

<section class="causas-grid" data-align={subheadingAlign}>
  <h2>{heading}</h2>
  {lead && <p class="subheading lead"><strong>{lead}</strong></p>}
  {subtitulo && <h3 class="subtitulo">{subtitulo}</h3>}
  {parrafos.map((t) => <p class="subheading">{t}</p>)}
  {subtituloLista && <h3 class="subtitulo">{subtituloLista}</h3>}
  <div class="grid" data-count={causas.length}>
    {causas.map((c) => (
      <div class="causa-card">
        {c.icon && (
          typeof c.icon === 'string'
            ? <span class="icon" aria-hidden="true">{c.icon}</span>
            : <Image class="icon-img" src={c.icon} alt="" width={600} />
        )}
        <h3>{c.title}</h3>
        <p>{c.text}</p>
      </div>
    ))}
  </div>
</section>

<style>
  /* Espaciado medido en el original (Fatiga crónica): 57px entre la
     sección anterior y el H2, y ~100px entre la frase y las tarjetas
     (38.5px del párrafo + 60px). */
  .causas-grid {
    padding-top: 57px;
  }
  .causas-grid .grid {
    margin-top: 60px;
  }
  .causas-grid .subtitulo + .grid {
    margin-top: 30px;
  }
  /* Subtítulos H3 dentro de la sección (Sueño: "¿Por qué no puedo
     dormir?", "Causas más frecuentes…"): Rubik 500 26px #212121, izquierda. */
  .subtitulo {
    font-family: var(--font-heading);
    font-size: 26px;
    font-weight: 500;
    line-height: 1.3;
    color: #212121;
    text-align: left;
    margin: 1.5rem 0 1rem;
  }
  /* 8 causas (Sueño): 2 tarjetas anchas arriba y 3 + 3 debajo. */
  .grid[data-count='8'] {
    grid-template-columns: repeat(6, 1fr);
  }
  .grid[data-count='8'] .causa-card {
    grid-column: span 2;
  }
  .grid[data-count='8'] .causa-card:nth-child(-n + 2) {
    grid-column: span 3;
  }
  @media (max-width: 900px) {
    .grid[data-count='8'] {
      grid-template-columns: repeat(2, 1fr);
    }
    .grid[data-count='8'] .causa-card,
    .grid[data-count='8'] .causa-card:nth-child(-n + 2) {
      grid-column: auto;
    }
  }
  .grid {
    /* 3 columnas fijas, como en el original (revisión visual 2026-09-14):
       con auto-fit a 220px mínimo cabían 4 en el ancho del contenedor
       (1140px), un valor que el original nunca usa para este patrón. */
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  .subheading {
    text-align: justify;
    font-family: var(--font-body);
    font-size: 22px;
    line-height: 33px;
  }
  [data-align='center'] .subheading {
    text-align: center;
  }
  .subheading.lead {
    margin-bottom: 0;
  }
  .causa-card {
    background: #fff;
    border-radius: 20px;
    box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);
    padding: 0 20px 20px;
    text-align: center;
    transition: box-shadow 0.3s;
  }
  .causa-card:hover {
    box-shadow: 10px 10px 10px rgba(0, 0, 0, 0.5);
  }
  .causa-card:hover h3 {
    color: #ac6ec1;
  }
  .icon {
    font-size: 2rem;
  }
  .icon-img {
    width: 77%;
    height: auto;
    object-fit: contain;
    margin: 0 auto 0.5rem;
  }
  .causa-card h3 {
    font-size: 26px;
    font-weight: 600;
    color: #6c2f50;
    margin: 0 0 10px;
    transition: color 0.3s;
  }
  .causa-card p {
    font-family: var(--font-body);
    font-size: 20px;
    line-height: 33px;
    margin: 0;
  }
</style>
