RewriteRule ^category/metabolismo/ayuno-intermitente/?$ /ayuno-intermitente/ [R=301,L,NE]
RewriteRule ^category/metabolismo/ayuno-intermitente/page/\d+/?$ /ayuno-intermitente/ [R=301,L,NE]
