RewriteRule ^category/energia/sueno/?$ /sueno/ [R=301,L,NE]
RewriteRule ^category/energia/sueno/page/\d+/?$ /sueno/ [R=301,L,NE]
RewriteRule ^category/energia/?$ /energia/ [R=301,L,NE]
RewriteRule ^category/energia/page/\d+/?$ /energia/ [R=301,L,NE]
RewriteRule ^category/recetas/keto-low-carb/?$ /recetas-keto-low-carb/ [R=301,L,NE]
RewriteRule ^category/recetas/keto-low-carb/page/\d+/?$ /recetas-keto-low-carb/ [R=301,L,NE]
RewriteRule ^category/recetas/?$ /recetas/ [R=301,L,NE]
RewriteRule ^category/recetas/page/\d+/?$ /recetas/ [R=301,L,NE]
RewriteRule ^category/radar-de-salud/?$ /radar-de-salud/ [R=301,L,NE]
RewriteRule ^category/radar-de-salud/page/\d+/?$ /radar-de-salud/ [R=301,L,NE]
RewriteRule ^author/([^/]+)/?$ /quienes-somos/ [R=301,L,NE]
RewriteRule ^author/([^/]+)/page/\d+/?$ /quienes-somos/ [R=301,L,NE]
RewriteRule ^tag/wegovi/?$ /buscar/?q=wegovy [R=301,L,NE]
RewriteRule ^tag/legacy/?$ /blog/ [R=301,L,NE]
RewriteRule ^tag/([^/]+)/page/\d+/?$ /buscar/?q=$1 [R=301,L,NE]
RewriteRule ^tag/([^/]+)/?$ /buscar/?q=$1 [R=301,L,NE]
</IfModule>

# Caché del navegador: los archivos de _astro llevan huella en el nombre y
# no cambian nunca; las páginas se revalidan siempre.
<IfModule mod_headers.c>
<FilesMatch "\.(webp|avif|jpe?g|png|gif|svg|woff2?|css|js)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(html|xml|txt)$">
Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
