# Configuración del hosting para la web nueva (Astro, estática).
# GENERADO por scripts/generar_htaccess.py a partir de vercel.json: no
# editar las redirecciones aquí, sino en vercel.json, y volver a generar.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Siempre HTTPS y sin «www» (la dirección principal es clubdenutricion.es).
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://clubdenutricion.es/$1 [R=301,L,NE]

# Direcciones antiguas del WordPress (82 reglas).
RewriteRule ^alimentacion-2/?$ /alimentacion/ [R=301,L,NE]
RewriteRule ^ayuno-intermitente-2/?$ /ayuno-intermitente/ [R=301,L,NE]
RewriteRule ^contacto/?$ /quienes-somos/ [R=301,L,NE]
RewriteRule ^coach/contacto/?$ /quienes-somos/ [R=301,L,NE]
RewriteRule ^mente/?$ /mentalidad/ [R=301,L,NE]
RewriteRule ^nutricion/?$ /alimentacion/ [R=301,L,NE]
RewriteRule ^nutricion/macronutrientes-y-micronutrientes/?$ /macronutrientes-y-micronutrientes/ [R=301,L,NE]
RewriteRule ^cuerpo/?$ /relacion-cuerpo-mujeres/ [R=301,L,NE]
RewriteRule ^keto-lowcarb/?$ /recetas-keto-low-carb/ [R=301,L,NE]
RewriteRule ^recetas-sanas-keto-y-low-carb/?$ /recetas-keto-low-carb/ [R=301,L,NE]
RewriteRule ^servicios-del-club-de-nutricion/?$ /quienes-somos/ [R=301,L,NE]
RewriteRule ^coaching-nutricional/?$ /que-es-el-coaching-nutricional/ [R=301,L,NE]
RewriteRule ^alimentacion/\d+/?$ /alimentacion/ [R=301,L,NE]
RewriteRule ^alimentacion/page/\d+/?$ /alimentacion/ [R=301,L,NE]
RewriteRule ^category/nutricion/alimentos/?$ /alimentos/ [R=301,L,NE]
RewriteRule ^category/nutricion/alimentos/page/\d+/?$ /alimentos/ [R=301,L,NE]
RewriteRule ^category/nutricion/macronutrientes/?$ /macronutrientes/ [R=301,L,NE]
RewriteRule ^category/nutricion/macronutrientes/page/\d+/?$ /macronutrientes/ [R=301,L,NE]
RewriteRule ^category/nutricion/micronutrientes/?$ /micronutrientes/ [R=301,L,NE]
RewriteRule ^category/nutricion/micronutrientes/page/\d+/?$ /micronutrientes/ [R=301,L,NE]
RewriteRule ^category/nutricion/patrones-alimentarios/?$ /patrones-alimentarios/ [R=301,L,NE]
RewriteRule ^category/nutricion/patrones-alimentarios/page/\d+/?$ /patrones-alimentarios/ [R=301,L,NE]
RewriteRule ^category/nutricion/?$ /alimentacion/ [R=301,L,NE]
RewriteRule ^category/nutricion/page/\d+/?$ /alimentacion/ [R=301,L,NE]
RewriteRule ^category/mentalidad/ansiedad-por-la-comida/?$ /ansiedad-comida/ [R=301,L,NE]
RewriteRule ^category/mentalidad/ansiedad-por-la-comida/page/\d+/?$ /ansiedad-comida/ [R=301,L,NE]
RewriteRule ^category/mentalidad/estres-y-habitos/?$ /estres-habitos/ [R=301,L,NE]
RewriteRule ^category/mentalidad/estres-y-habitos/page/\d+/?$ /estres-habitos/ [R=301,L,NE]
RewriteRule ^category/mentalidad/relacion-con-el-cuerpo/?$ /relacion-cuerpo-mujeres/ [R=301,L,NE]
RewriteRule ^category/mentalidad/relacion-con-el-cuerpo/page/\d+/?$ /relacion-cuerpo-mujeres/ [R=301,L,NE]
RewriteRule ^category/mentalidad/?$ /mentalidad/ [R=301,L,NE]
