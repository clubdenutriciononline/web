RewriteRule ^category/hormonas/menopausia/page/\d+/?$ /menopausia/ [R=301,L,NE]
RewriteRule ^category/hormonas/perimenopausia/?$ /perimenopausia/ [R=301,L,NE]
RewriteRule ^category/hormonas/perimenopausia/page/\d+/?$ /perimenopausia/ [R=301,L,NE]
