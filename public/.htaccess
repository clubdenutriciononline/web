RewriteRule ^category/microbiota/digestion/?$ /digestion/ [R=301,L,NE]
RewriteRule ^category/microbiota/digestion/page/\d+/?$ /digestion/ [R=301,L,NE]
RewriteRule ^category/microbiota/inflamacion-intestinal/?$ /inflamacion-intestinal/ [R=301,L,NE]
RewriteRule ^category/microbiota/inflamacion-intestinal/page/\d+/?$ /inflamacion-intestinal/ [R=301,L,NE]
RewriteRule ^category/microbiota/probioticos-alimentacion/?$ /probioticos-alimentacion/ [R=301,L,NE]
RewriteRule ^category/microbiota/probioticos-alimentacion/page/\d+/?$ /probioticos-alimentacion/ [R=301,L,NE]
